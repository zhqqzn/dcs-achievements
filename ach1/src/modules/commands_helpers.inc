/*
 * Функциональный модуль: commands_helpers.inc
 * Назначение: Обработка RESTART/ошибки, десятичный разбор uint16 с защитой от переполнения и копирование строк.
 * Фрагмент включается в одну единицу трансляции firmware.S: общие метки SRAM
 * остаются видимыми без отдельной таблицы экспортируемых символов, а порядок
 * критичных инструкций и временные характеристики не меняются компоновкой.
 */
parse_restart_command:
    ldi r30, lo8(cmd_buffer) /* загрузить константу lo8(cmd_buffer) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(cmd_buffer) /* загрузить константу hi8(cmd_buffer) в r31; следующая инструкция использует это значение. */
    ldi r28, lo8(cmd_restart) /* загрузить константу lo8(cmd_restart) в r28; следующая инструкция использует это значение. */
    ldi r29, hi8(cmd_restart) /* загрузить константу hi8(cmd_restart) в r29; следующая инструкция использует это значение. */
parse_restart_compare:
    ld r18, Z+ /* Прочитать байт из SRAM по адресу Z в r18 и увеличить указатель на 1. */
    ld r19, Y+ /* Прочитать байт из SRAM по адресу Y в r19 и увеличить указатель на 1. */
    cp r18, r19 /* сравнить операнды r18, r19; выставить флаги сравнения. */
    breq parse_restart_chars_equal /* если Z=1 (результат равен нулю): перейти к parse_restart_chars_equal. */
    rjmp command_error /* безусловно передать управление на метку command_error; выполнение продолжится с указанной метки. */
parse_restart_chars_equal:
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    brne parse_restart_compare /* если Z=0 (результат не равен нулю): перейти к parse_restart_compare. */
    rjmp command_accept_restart /* безусловно передать управление на метку command_accept_restart; выполнение продолжится с указанной метки. */

command_accept_restart:
    ldi r18, 1 /* загрузить константу 1 в r18; следующая инструкция использует это значение. */
    sts restart_pending, r18 /* сохранить restart_pending в SRAM (r18). */
    ldi r24, EV_OK /* загрузить константу EV_OK в r24; следующая инструкция использует это значение. */
    rcall event_enqueue /* вызвать подпрограмму event_enqueue — поместить код ответа в кольцевую очередь; используется главным циклом. */
    ret /* вернуться к инструкции после соответствующего RCALL. */

command_error:
    ldi r24, EV_ERROR /* загрузить константу EV_ERROR в r24; следующая инструкция использует это значение. */
    rcall event_enqueue /* вызвать подпрограмму event_enqueue — поместить код ответа в кольцевую очередь; используется главным циклом. */
    ret /* вернуться к инструкции после соответствующего RCALL. */

/* Преобразовать строку по адресу Z в uint16: результат r25:r24, признак успеха — r23. */
parse_decimal_u16:
    clr r24 /* обнулить регистр r24 перед его повторным использованием. */
    clr r25 /* обнулить регистр r25 перед его повторным использованием. */
    clr r23 /* обнулить регистр r23 перед его повторным использованием. */
    ld r18, Z+ /* Прочитать байт из SRAM по адресу Z в r18 и увеличить указатель на 1. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq parse_decimal_return /* если Z=1 (результат равен нулю): перейти к parse_decimal_return. */
parse_decimal_loop:
    cpi r18, '0' /* сравнить r18 с код символа '0', не сохраняя результат вычитания; далее проверяются флаги. */
    brlo parse_decimal_return /* если C=1 (меньше без знака): перейти к parse_decimal_return. */
    cpi r18, '9'+1 /* сравнить r18 с код символа '9'+1, не сохраняя результат вычитания; далее проверяются флаги. */
    brsh parse_decimal_return /* если C=0 (не меньше без знака): перейти к parse_decimal_return. */
    subi r18, '0' /* вычесть константу из регистра (r18, '0'); флаги нужны для проверки переполнения или следующего байта. */

    /* Проверить переполнение до accumulator*10+digit: uint16 раскладывается как 6553*10+5. Значение накопителя не может быть больше 6553, а при 6553 следующая цифра должна быть не больше 5. */
    cpi r25, hi8(6553) /* сравнить r25 с константу hi8(6553), не сохраняя результат вычитания; далее проверяются флаги. */
    brlo parse_decimal_accumulator_ok /* если C=1 (меньше без знака): перейти к parse_decimal_accumulator_ok. */
    brne parse_decimal_return /* если Z=0 (результат не равен нулю): перейти к parse_decimal_return. */
    cpi r24, lo8(6553) /* сравнить r24 с константу lo8(6553), не сохраняя результат вычитания; далее проверяются флаги. */
    brlo parse_decimal_accumulator_ok /* если C=1 (меньше без знака): перейти к parse_decimal_accumulator_ok. */
    brne parse_decimal_return /* если Z=0 (результат не равен нулю): перейти к parse_decimal_return. */
    cpi r18, 6 /* сравнить r18 с константу 6, не сохраняя результат вычитания; далее проверяются флаги. */
    brsh parse_decimal_return /* если C=0 (не меньше без знака): перейти к parse_decimal_return. */
parse_decimal_accumulator_ok:
    mov r20, r24 /* скопировать значение r20, r24; исходный регистр не изменяется. */
    mov r21, r25 /* скопировать значение r21, r25; исходный регистр не изменяется. */
    lsl r24 /* сдвинуть биты влево, младший бит становится нулём: r24; используется для арифметики/разбора числа. */
    rol r25 /* сдвинуть влево через флаг переноса: r25; используется для арифметики/разбора числа. */
    lsl r24 /* сдвинуть биты влево, младший бит становится нулём: r24; используется для арифметики/разбора числа. */
    rol r25 /* сдвинуть влево через флаг переноса: r25; используется для арифметики/разбора числа. */
    lsl r24 /* сдвинуть биты влево, младший бит становится нулём: r24; используется для арифметики/разбора числа. */
    rol r25 /* сдвинуть влево через флаг переноса: r25; используется для арифметики/разбора числа. */
    add r24, r20 /* сложить операнды (r24, r20); флаги нужны для проверки переполнения или следующего байта. */
    adc r25, r21 /* сложить операнды с переносом от младшего байта (r25, r21); флаги нужны для проверки переполнения или следующего байта. */
    brcs parse_decimal_return /* если C=1 (есть перенос): перейти к parse_decimal_return. */
    add r24, r20 /* сложить операнды (r24, r20); флаги нужны для проверки переполнения или следующего байта. */
    adc r25, r21 /* сложить операнды с переносом от младшего байта (r25, r21); флаги нужны для проверки переполнения или следующего байта. */
    brcs parse_decimal_return /* если C=1 (есть перенос): перейти к parse_decimal_return. */
    add r24, r18 /* сложить операнды (r24, r18); флаги нужны для проверки переполнения или следующего байта. */
    adc r25, r1 /* сложить операнды с переносом от младшего байта (r25, r1); флаги нужны для проверки переполнения или следующего байта. */
    brcs parse_decimal_return /* если C=1 (есть перенос): перейти к parse_decimal_return. */
    ld r18, Z+ /* Прочитать байт из SRAM по адресу Z в r18 и увеличить указатель на 1. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    brne parse_decimal_loop /* если Z=0 (результат не равен нулю): перейти к parse_decimal_loop. */
    ldi r23, 1 /* загрузить константу 1 в r23; следующая инструкция использует это значение. */
parse_decimal_return:
    ret /* вернуться к инструкции после соответствующего RCALL. */

/* Скопировать строку SRAM из Z в Y вместе с завершающим нулём. */
copy_z_to_y:
copy_z_to_y_loop:
    ld r18, Z+ /* Прочитать байт из SRAM по адресу Z в r18 и увеличить указатель на 1. */
    st Y+, r18 /* Записать r18 по адресу Y и увеличить указатель на 1. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    brne copy_z_to_y_loop /* если Z=0 (результат не равен нулю): перейти к copy_z_to_y_loop. */
    ret /* вернуться к инструкции после соответствующего RCALL. */
