/*
 * Функциональный модуль: commands_input_timer.inc
 * Назначение: Приём символов команды и разбор команд изменения одного или двух периодов.
 * Фрагмент включается в одну единицу трансляции firmware.S: общие метки SRAM
 * остаются видимыми без отдельной таблицы экспортируемых символов, а порядок
 * критичных инструкций и временные характеристики не меняются компоновкой.
 */
/* ---------------------------- USART command parser ------------------------ */
process_rx_char:
    cpi r24, 10 /* LF игнорируется; CR завершает ввод команды; сравнить r24 с константу 10, не сохраняя результат вычитания; далее проверяются флаги. */
    breq process_rx_return /* если Z=1 (результат равен нулю): перейти к process_rx_return. */
    cpi r24, 13 /* сравнить r24 с константу 13, не сохраняя результат вычитания; далее проверяются флаги. */
    breq process_rx_cr /* если Z=1 (результат равен нулю): перейти к process_rx_cr. */
    lds r18, cmd_len /* прочитать из SRAM текущая длина команды в r18. */
    cpi r18, COMMAND_MAX /* сравнить r18 с константу COMMAND_MAX, не сохраняя результат вычитания; далее проверяются флаги. */
    brsh process_rx_overflow /* если C=0 (не меньше без знака): перейти к process_rx_overflow. */
    ldi r30, lo8(cmd_buffer) /* загрузить константу lo8(cmd_buffer) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(cmd_buffer) /* загрузить константу hi8(cmd_buffer) в r31; следующая инструкция использует это значение. */
    add r30, r18 /* сложить операнды (r30, r18); флаги нужны для проверки переполнения или следующего байта. */
    adc r31, r1 /* сложить операнды с переносом от младшего байта (r31, r1); флаги нужны для проверки переполнения или следующего байта. */
    st Z, r24 /* Записать r24 в SRAM по адресу Z; указатель не меняется. */
    inc r18 /* увеличить на 1 (r18); флаги результата используются далее. */
    sts cmd_len, r18 /* сохранить cmd_len в SRAM (r18). */
    ret /* вернуться к инструкции после соответствующего RCALL. */
process_rx_cr:
    lds r18, cmd_len /* прочитать из SRAM текущая длина команды в r18. */
    ldi r30, lo8(cmd_buffer) /* загрузить константу lo8(cmd_buffer) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(cmd_buffer) /* загрузить константу hi8(cmd_buffer) в r31; следующая инструкция использует это значение. */
    add r30, r18 /* сложить операнды (r30, r18); флаги нужны для проверки переполнения или следующего байта. */
    adc r31, r1 /* сложить операнды с переносом от младшего байта (r31, r1); флаги нужны для проверки переполнения или следующего байта. */
    clr r19 /* обнулить регистр r19 перед его повторным использованием. */
    st Z, r19 /* Записать r19 в SRAM по адресу Z; указатель не меняется. */
    sts cmd_len, r19 /* сохранить cmd_len в SRAM (r19). */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq process_rx_return /* если Z=1 (результат равен нулю): перейти к process_rx_return. */
    rcall parse_command /* вызвать подпрограмму parse_command — выбрать обработчик команды по первому символу T/S/R. */
    ret /* вернуться к инструкции после соответствующего RCALL. */
process_rx_overflow:
    clr r18 /* обнулить регистр r18 перед его повторным использованием. */
    sts cmd_len, r18 /* сохранить cmd_len в SRAM (r18). */
    ldi r24, EV_ERROR /* загрузить константу EV_ERROR в r24; следующая инструкция использует это значение. */
    rcall event_enqueue /* вызвать подпрограмму event_enqueue — поместить код ответа в кольцевую очередь; используется главным циклом. */
process_rx_return:
    ret /* вернуться к инструкции после соответствующего RCALL. */

parse_command:
    lds r18, cmd_buffer /* прочитать из SRAM буфер команды в r18. */
    cpi r18, 'T' /* сравнить r18 с код символа 'T', не сохраняя результат вычитания; далее проверяются флаги. */
    breq parse_timer_command /* если Z=1 (результат равен нулю): перейти к parse_timer_command. */
    cpi r18, 'S' /* сравнить r18 с код символа 'S', не сохраняя результат вычитания; далее проверяются флаги. */
    BREQ_LONG parse_string_command /* расширенный переход при Z=1; цель — parse_string_command. */
    cpi r18, 'R' /* сравнить r18 с код символа 'R', не сохраняя результат вычитания; далее проверяются флаги. */
    BREQ_LONG parse_restart_command /* расширенный переход при Z=1; цель — parse_restart_command. */
    rjmp command_error /* безусловно передать управление на метку command_error; выполнение продолжится с указанной метки. */

/* Поддерживаются T1=число, T2=число или атомарная пара T=t1,t2. */
parse_timer_command:
    lds r18, cmd_buffer+1 /* прочитать из SRAM буфер команды в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    cpi r18, '=' /* сравнить r18 с код символа '=', не сохраняя результат вычитания; далее проверяются флаги. */
    breq parse_timer_pair /* если Z=1 (результат равен нулю): перейти к parse_timer_pair. */
    cpi r18, '1' /* сравнить r18 с код символа '1', не сохраняя результат вычитания; далее проверяются флаги. */
    breq parse_timer1 /* если Z=1 (результат равен нулю): перейти к parse_timer1. */
    cpi r18, '2' /* сравнить r18 с код символа '2', не сохраняя результат вычитания; далее проверяются флаги. */
    breq parse_timer2 /* если Z=1 (результат равен нулю): перейти к parse_timer2. */
    rjmp command_error /* безусловно передать управление на метку command_error; выполнение продолжится с указанной метки. */

parse_timer1:
    lds r18, cmd_buffer+2 /* прочитать из SRAM буфер команды в r18; смещение 2 выбирает следующий байт многобайтного значения. */
    cpi r18, '=' /* сравнить r18 с код символа '=', не сохраняя результат вычитания; далее проверяются флаги. */
    BRNE_LONG command_error /* расширенный переход при Z=0; цель — command_error. */
    ldi r30, lo8(cmd_buffer+3) /* загрузить константу lo8(cmd_buffer+3) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(cmd_buffer+3) /* загрузить константу hi8(cmd_buffer+3) в r31; следующая инструкция использует это значение. */
    rcall parse_decimal_u16 /* вызвать подпрограмму parse_decimal_u16 — преобразовать десятичное NUL-завершённое число в uint16, проверяя переполнение до умножения. */
    tst r23 /* проверить r23 без изменения самого регистра; результат задаёт флаги Z/N. */
    BREQ_LONG command_error /* расширенный переход при Z=1; цель — command_error. */
    sts pair_value1, r24 /* сохранить pair_value1 в SRAM (r24). */
    sts pair_value1+1, r25 /* сохранить pair_value1+1 в SRAM (r25). */
    sts test_t1, r24 /* сохранить test_t1 в SRAM (r24). */
    sts test_t1+1, r25 /* сохранить test_t1+1 в SRAM (r25). */
    lds r18, candidate_t2 /* прочитать из SRAM кандидатный период T2 в r18. */
    sts test_t2, r18 /* сохранить test_t2 в SRAM (r18). */
    lds r18, candidate_t2+1 /* прочитать из SRAM кандидатный период T2 в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    sts test_t2+1, r18 /* сохранить test_t2+1 в SRAM (r18). */
    rjmp parse_timer_validate /* безусловно передать управление на метку parse_timer_validate; выполнение продолжится с указанной метки. */

parse_timer2:
    lds r18, cmd_buffer+2 /* прочитать из SRAM буфер команды в r18; смещение 2 выбирает следующий байт многобайтного значения. */
    cpi r18, '=' /* сравнить r18 с код символа '=', не сохраняя результат вычитания; далее проверяются флаги. */
    BRNE_LONG command_error /* расширенный переход при Z=0; цель — command_error. */
    ldi r30, lo8(cmd_buffer+3) /* загрузить константу lo8(cmd_buffer+3) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(cmd_buffer+3) /* загрузить константу hi8(cmd_buffer+3) в r31; следующая инструкция использует это значение. */
    rcall parse_decimal_u16 /* вызвать подпрограмму parse_decimal_u16 — преобразовать десятичное NUL-завершённое число в uint16, проверяя переполнение до умножения. */
    tst r23 /* проверить r23 без изменения самого регистра; результат задаёт флаги Z/N. */
    BREQ_LONG command_error /* расширенный переход при Z=1; цель — command_error. */
    sts pair_value2, r24 /* сохранить pair_value2 в SRAM (r24). */
    sts pair_value2+1, r25 /* сохранить pair_value2+1 в SRAM (r25). */
    lds r18, candidate_t1 /* прочитать из SRAM кандидатный период T1 в r18. */
    sts test_t1, r18 /* сохранить test_t1 в SRAM (r18). */
    lds r18, candidate_t1+1 /* прочитать из SRAM кандидатный период T1 в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    sts test_t1+1, r18 /* сохранить test_t1+1 в SRAM (r18). */
    sts test_t2, r24 /* сохранить test_t2 в SRAM (r24). */
    sts test_t2+1, r25 /* сохранить test_t2+1 в SRAM (r25). */
    rjmp parse_timer_validate /* безусловно передать управление на метку parse_timer_validate; выполнение продолжится с указанной метки. */

parse_timer_pair:
    rcall parse_pair_command /* вызвать подпрограмму parse_pair_command — найти запятую, временно разделить команду и проверить оба 16-битных числа. */
    tst r23 /* проверить r23 без изменения самого регистра; результат задаёт флаги Z/N. */
    BREQ_LONG command_error /* расширенный переход при Z=1; цель — command_error. */
    lds r18, pair_value1 /* прочитать из SRAM первое число пары в r18. */
    sts test_t1, r18 /* сохранить test_t1 в SRAM (r18). */
    lds r18, pair_value1+1 /* прочитать из SRAM первое число пары в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    sts test_t1+1, r18 /* сохранить test_t1+1 в SRAM (r18). */
    lds r18, pair_value2 /* прочитать из SRAM второе число пары в r18. */
    sts test_t2, r18 /* сохранить test_t2 в SRAM (r18). */
    lds r18, pair_value2+1 /* прочитать из SRAM второе число пары в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    sts test_t2+1, r18 /* сохранить test_t2+1 в SRAM (r18). */

parse_timer_validate:
    lds r18, candidate_str1_len /* прочитать из SRAM длина строки-кандидата 1 в r18. */
    sts test_len1, r18 /* сохранить test_len1 в SRAM (r18). */
    lds r18, candidate_str2_len /* прочитать из SRAM длина строки-кандидата 2 в r18. */
    sts test_len2, r18 /* сохранить test_len2 в SRAM (r18). */
    rcall config_validate /* вызвать подпрограмму config_validate — проверить, помещаются ли периодические строки и служебный ответ в доступные непересекающиеся окна. */
    tst r24 /* проверить r24 без изменения самого регистра; результат задаёт флаги Z/N. */
    BREQ_LONG command_error /* расширенный переход при Z=1; цель — command_error. */
    lds r18, test_t1 /* прочитать из SRAM тестовый T1 в r18. */
    sts candidate_t1, r18 /* сохранить candidate_t1 в SRAM (r18). */
    lds r18, test_t1+1 /* прочитать из SRAM тестовый T1 в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    sts candidate_t1+1, r18 /* сохранить candidate_t1+1 в SRAM (r18). */
    lds r18, test_t2 /* прочитать из SRAM тестовый T2 в r18. */
    sts candidate_t2, r18 /* сохранить candidate_t2 в SRAM (r18). */
    lds r18, test_t2+1 /* прочитать из SRAM тестовый T2 в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    sts candidate_t2+1, r18 /* сохранить candidate_t2+1 в SRAM (r18). */
    rjmp command_accept_restart /* безусловно передать управление на метку command_accept_restart; выполнение продолжится с указанной метки. */
