/*
 * Функциональный модуль: timer1.inc
 * Назначение: Timer1 формирует точный поток TIMER1_STR и одноразовое событие запуска Timer2.
 * Timer1 Compare A задаёт период ping; Compare B используется только для запуска
 * независимого аппаратного Timer2 в требуемой фазе. Сам поток pong далее формирует Timer2.
 */

/* Инициализировать Timer1 и рассчитать первые два события относительно нулевой эпохи. */
timer1_init:
    clr r16                         /* Обнулить регистр перед начальной настройкой таймера. */
    out _SFR_IO_ADDR(TCCR1A), r16   /* Отключить выходные режимы сравнения Timer1. */
    out _SFR_IO_ADDR(TCCR1B), r16   /* Остановить Timer1 на время начальной настройки. */
    out _SFR_IO_ADDR(TCNT1H), r16   /* Обнулить старший байт 16-разрядного счётчика. */
    out _SFR_IO_ADDR(TCNT1L), r16   /* Обнулить младший байт и зафиксировать TCNT1=0. */

    lds r18, active_t1              /* Загрузить младший байт периода потока 1. */
    lds r19, active_t1+1            /* Загрузить старший байт периода потока 1. */
    subi r18, COMPARE_EARLY_A       /* Сдвинуть первое сравнение раньше на измеренную задержку ISR. */
    sbci r19, 0                     /* Учесть заём при вычитании из 16-разрядного периода. */
    out _SFR_IO_ADDR(OCR1AH), r19   /* Сначала записать старший байт OCR1A. */
    out _SFR_IO_ADDR(OCR1AL), r18   /* Запись младшего байта фиксирует полное значение OCR1A. */

    /* Рассчитать фазу первого compare-B из длины строки и зарезервированного окна USART. */
    lds r24, active_str1_len        /* Взять длину первой строки вместе с CR/LF. */
    rcall calc_line_cycles          /* Перевести длину в длительность передачи в тактах CPU. */
#if TASK2_PERIODIC_ONLY
    ldi r18, lo8(OUTPUT_GUARD_CYCLES) /* В задании 2 после ping нужен только защитный промежуток. */
    add r20, r18                    /* Прибавить младший байт защитного промежутка. */
    ldi r18, hi8(OUTPUT_GUARD_CYCLES) /* Загрузить старший байт защитного промежутка. */
    adc r21, r18                    /* Прибавить старший байт с переносом. */
#else
    ldi r18, lo8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP) /* Зарезервировать время ответа OK/ERR и подготовки. */
    add r20, r18                    /* Добавить младшую часть окна управления. */
    ldi r18, hi8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP) /* Загрузить старшую часть окна управления. */
    adc r21, r18                    /* Добавить старшую часть окна с переносом. */
#endif
    subi r20, COMPARE_EARLY_PHASE   /* Компенсировать путь от Timer1B compare до сброса PSR2. */
    sbci r21, 0                     /* Учесть заём старшего байта фазы. */
    out _SFR_IO_ADDR(OCR1BH), r21   /* Записать старший байт одноразового фазового compare-B. */
    out _SFR_IO_ADDR(OCR1BL), r20   /* Записать младший байт OCR1B. */

    rcall timer2_configure          /* Остановить Timer2, загрузить OCR2 и кеш первого байта pong. */
    clr r16                         /* Подготовить нулевой флаг timer2_started. */
    sts timer2_started, r16         /* Пока compare-B не сработал, Timer2 не формирует периодические события. */
    ldi r16, (1<<OCF2)|(1<<OCF1A)|(1<<OCF1B) /* Очистить флаги сравнения обоих аппаратных таймеров. */
    out _SFR_IO_ADDR(TIFR), r16     /* В TIFR запись единицы очищает соответствующие флаги. */
    ldi r16, (1<<OCIE2)|(1<<OCIE1A)|(1<<OCIE1B) /* Разрешить Compare2 и оба нужных вектора Timer1. */
    out _SFR_IO_ADDR(TIMSK), r16    /* Включить прерывания сравнения Timer2 и Timer1 A/B. */
    ldi r16, (1<<CS10)              /* Выбрать внутренний тактовый сигнал без делителя для Timer1. */
    out _SFR_IO_ADDR(TCCR1B), r16   /* Запустить Timer1; эта запись задаёт начало временной эпохи. */
    ret                             /* Вернуться в вызывающую подпрограмму. */

/* Вектор Compare A имеет номер 6. В таблице векторов ATmega8 используется RJMP (2 такта), а не JMP. Значения сравнения сдвинуты на COMPARE_EARLY_A/B для компенсации измеренного пути до OUT UDR; после изменений исходника/компилятора калибровку необходимо повторить. */
.global __vector_6
__vector_6:
    push r0 /* сохранить r0 на стеке, чтобы не потерять значение при вызове/прерывании. */
    in r0, _SFR_IO_ADDR(SREG) /* прочитать регистр флагов процессора (SREG) в r0. */
    push r0 /* сохранить r0 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r24 /* сохранить r24 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r30 /* сохранить r30 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r31 /* сохранить r31 на стеке, чтобы не потерять значение при вызове/прерывании. */

    ldi r30, lo8(active_str1) /* загрузить константу lo8(active_str1) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(active_str1) /* загрузить константу hi8(active_str1) в r31; следующая инструкция использует это значение. */
    ld r24, Z+ /* Прочитать байт из SRAM по адресу Z в r24 и увеличить указатель на 1. */
    out _SFR_IO_ADDR(UDR), r24 /* записать r24 в регистр данных USART (UDR). */
#if TRACE_SCHEDULE
    /* Только для трассировки: отметить исходящие записи, отличая их от чтения UDR при приёме. */
    out _SFR_IO_ADDR(PORTB), r24 /* записать r24 в диагностический порт зеркалирования TX (PORTB). */
#endif

    /* Очистить TXC, сохранив U2X; это выполняется после критичной записи в UDR. */
    ldi r24, (1<<TXC)|(1<<U2X) /* подготовить битовую маску настройки в r24; следующая инструкция использует это значение. */
    out _SFR_IO_ADDR(UCSRA), r24 /* записать r24 в статус/управление USART (UCSRA). */
    sts tx_ptr_lo, r30 /* сохранить tx_ptr_lo в SRAM (r30). */
    sts tx_ptr_hi, r31 /* сохранить tx_ptr_hi в SRAM (r31). */
    ldi r24, 1 /* загрузить константу 1 в r24; следующая инструкция использует это значение. */
    sts tx_kind, r24 /* сохранить tx_kind в SRAM (r24). */
    clr r24 /* обнулить регистр r24 перед его повторным использованием. */
    sts control_slot_open, r24 /* сохранить control_slot_open в SRAM (r24). */

    /* Следующий OCR1A считается от предыдущего OCR, а не от момента входа в ISR. */
    push r18 /* сохранить r18 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r19 /* сохранить r19 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r20 /* сохранить r20 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r21 /* сохранить r21 на стеке, чтобы не потерять значение при вызове/прерывании. */
    in r18, _SFR_IO_ADDR(OCR1AL) /* прочитать младший байт Compare A (OCR1AL) в r18. */
    in r19, _SFR_IO_ADDR(OCR1AH) /* прочитать старший байт Compare A (OCR1AH) в r19. */
    lds r20, active_t1 /* прочитать из SRAM активный период T1 в r20. */
    lds r21, active_t1+1 /* прочитать из SRAM активный период T1 в r21; смещение 1 выбирает следующий байт многобайтного значения. */
    add r18, r20 /* сложить операнды (r18, r20); флаги нужны для проверки переполнения или следующего байта. */
    adc r19, r21 /* сложить операнды с переносом от младшего байта (r19, r21); флаги нужны для проверки переполнения или следующего байта. */
    out _SFR_IO_ADDR(OCR1AH), r19 /* записать r19 в старший байт Compare A (OCR1AH). */
    out _SFR_IO_ADDR(OCR1AL), r18 /* записать r18 в младший байт Compare A (OCR1AL). */

    pop r21 /* восстановить прежнее значение r21 со стека. */
    pop r20 /* восстановить прежнее значение r20 со стека. */
    pop r19 /* восстановить прежнее значение r19 со стека. */
    pop r18 /* восстановить прежнее значение r18 со стека. */
    pop r31 /* восстановить прежнее значение r31 со стека. */
    pop r30 /* восстановить прежнее значение r30 со стека. */
    pop r24 /* восстановить прежнее значение r24 со стека. */
    pop r0 /* восстановить прежнее значение r0 со стека. */
    out _SFR_IO_ADDR(SREG), r0 /* записать r0 в регистр флагов процессора (SREG). */
    pop r0 /* восстановить прежнее значение r0 со стека. */
    reti /* завершить обработчик прерывания и восстановить разрешение прерываний. */
/*
 * Timer1 Compare B — одноразовый фазовый запуск независимого Timer2.
 * Регистр r2 зарезервирован за первым байтом pong; остальные процедуры и ISR его не изменяют.
 * COMPARE_EARLY_PHASE компенсирует фиксированный путь от Compare B через сброс
 * предделителя до первого OUT UDR в Compare2 ISR. Значение 23 — стартовая калибровка;
 * её необходимо перепроверить трассировкой после сборки отдельными Timer1/Timer2.
 */
.global __vector_7
__vector_7:
    push r0                         /* Сохранить регистр, используемый для чтения SREG. */
    in r0, _SFR_IO_ADDR(SREG)       /* Сохранить исходные флаги перед изменением SREG. */
    push r0                         /* Положить сохранённый SREG на стек. */
    push r18                        /* Сохранить r18, который используется для управления таймером. */
    in r18, _SFR_IO_ADDR(SFIOR)     /* Прочитать SFIOR, сохранив настройки других функций. */
    ori r18, (1<<PSR2)              /* Установить сброс предделителя Timer2, не меняя остальные биты. */
    out _SFR_IO_ADDR(SFIOR), r18    /* Сбросить фазу предделителя перед запуском Timer2. */
    clr r18                         /* Подготовить начальное значение счётчика Timer2. */
    out _SFR_IO_ADDR(TCNT2), r18    /* Начать период Timer2 с нулевого счётчика. */
    ldi r18, (1<<WGM21)|(1<<CS22)|(1<<CS20) /* CTC, внутренний такт и делитель 128. */
    out _SFR_IO_ADDR(TCCR2), r18    /* Запустить независимый Timer2; первое сравнение наступит через T2. */
    ldi r18, 1                      /* Отметить, что Timer2 теперь работает. */
    sts timer2_started, r18         /* Главный цикл теперь должен учитывать срок Timer2, а не OCR1B. */
    in r18, _SFR_IO_ADDR(TIMSK)     /* Прочитать текущую маску, не отключая прерывание Compare2. */
    andi r18, 0xF7                  /* Отключить только OCIE1B: фазовое событие должно быть одноразовым. */
    out _SFR_IO_ADDR(TIMSK), r18    /* Timer1A и Timer2 остаются активны независимо друг от друга. */
    pop r18                         /* Восстановить исходное значение r18. */
    pop r0                          /* Восстановить сохранённый SREG во временный r0. */
    out _SFR_IO_ADDR(SREG), r0      /* Восстановить исходные флаги процессора. */
    pop r0                          /* Восстановить r0 вызываемого кода. */
    reti                            /* Завершить одноразовый запуск Timer2. */
