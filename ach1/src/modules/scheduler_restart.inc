/*
 * Функциональный модуль: scheduler_restart.inc
 * Назначение: Планировщик применяет кандидатную конфигурацию в безопасном окне и пересчитывает точки сравнения.
 * Фрагмент включается в одну единицу трансляции firmware.S: общие метки SRAM
 * остаются видимыми без отдельной таблицы экспортируемых символов, а порядок
 * критичных инструкций и временные характеристики не меняются компоновкой.
 */
/* ----------------------------- Main scheduler ----------------------------- */
maybe_commit_restart:
    lds r18, restart_pending /* прочитать из SRAM флаг ожидающего перезапуска в r18. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    brne maybe_commit_pending_set /* Если флаг ненулевой, продолжить проверку ожидающего перезапуска. */
    rjmp maybe_commit_return /* Дальний выход оформлен через RJMP: условный BRxx имеет ограниченный диапазон. */
maybe_commit_pending_set:
    lds r18, control_slot_open /* прочитать из SRAM флаг свободного окна ответа в r18. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    brne maybe_commit_slot_open /* Если окно свободно, продолжить проверку состояния передачи. */
    rjmp maybe_commit_return /* Использовать безусловный относительный переход для дальнего выхода. */
maybe_commit_slot_open:
    lds r18, tx_kind /* прочитать из SRAM состояние передачи в r18. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    brne maybe_commit_return /* если Z=0 (результат не равен нулю): перейти к maybe_commit_return. */
    rcall get_next_compare_delta /* Получить консервативное расстояние до ближайшего аппаратного события без CLI-маскировки IRQ. */
    /* Снимок срока мог включать ISR, который начал передачу. Повторно проверить
       состояние: иначе после прерывания главный цикл мог перезаписать строку,
       пока Timer2 ещё передаёт её остаток. При достаточном запасе эти флаги уже
       не изменятся до завершения короткой фиксации конфигурации. */
    lds r18, restart_pending
    tst r18
    breq maybe_commit_return
    lds r18, control_slot_open
    tst r18
    breq maybe_commit_return
    lds r18, tx_kind
    tst r18
    brne maybe_commit_return
    /* Не менять активные буферы непосредственно перед ранее назначенным событием сравнения. */
    cpi r25, hi8(COMMIT_CHECK_AHEAD) /* сравнить r25 с константу hi8(COMMIT_CHECK_AHEAD), не сохраняя результат вычитания; далее проверяются флаги. */
    brlo maybe_commit_slot_missed /* если C=1 (меньше без знака): перейти к maybe_commit_slot_missed. */
    brne maybe_commit_do /* если Z=0 (результат не равен нулю): перейти к maybe_commit_do. */
    cpi r24, lo8(COMMIT_CHECK_AHEAD) /* сравнить r24 с константу lo8(COMMIT_CHECK_AHEAD), не сохраняя результат вычитания; далее проверяются флаги. */
    brlo maybe_commit_slot_missed /* если C=1 (меньше без знака): перейти к maybe_commit_slot_missed. */
    rjmp maybe_commit_do /* безусловно передать управление на метку maybe_commit_do; выполнение продолжится с указанной метки. */
maybe_commit_slot_missed:
    /* Не повторять снимок регистров под CLI непосредственно перед сроком сравнения. Оставить restart_pending установленным и повторить попытку в следующем окне после первой строки. */
    clr r18 /* обнулить регистр r18 перед его повторным использованием. */
    sts control_slot_open, r18 /* сохранить control_slot_open в SRAM (r18). */
    rjmp maybe_commit_return /* безусловно передать управление на метку maybe_commit_return; выполнение продолжится с указанной метки. */
maybe_commit_do:
    /* После завершения первой строки начинается безопасное окно: перенести кандидатную конфигурацию, пока Timer1 продолжает счёт. */
    lds r18, candidate_t1 /* прочитать из SRAM кандидатный период T1 в r18. */
    sts active_t1, r18 /* сохранить active_t1 в SRAM (r18). */
    lds r18, candidate_t1+1 /* прочитать из SRAM кандидатный период T1 в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    sts active_t1+1, r18 /* сохранить active_t1+1 в SRAM (r18). */
    lds r18, candidate_t2 /* прочитать из SRAM кандидатный период T2 в r18. */
    sts active_t2, r18 /* сохранить active_t2 в SRAM (r18). */
    lds r18, candidate_t2+1 /* прочитать из SRAM кандидатный период T2 в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    sts active_t2+1, r18 /* сохранить active_t2+1 в SRAM (r18). */
    lds r18, candidate_str1_len /* прочитать из SRAM длина строки-кандидата 1 в r18. */
    sts active_str1_len, r18 /* сохранить active_str1_len в SRAM (r18). */
    lds r18, candidate_str2_len /* прочитать из SRAM длина строки-кандидата 2 в r18. */
    sts active_str2_len, r18 /* сохранить active_str2_len в SRAM (r18). */

    ldi r30, lo8(candidate_str1) /* загрузить константу lo8(candidate_str1) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(candidate_str1) /* загрузить константу hi8(candidate_str1) в r31; следующая инструкция использует это значение. */
    ldi r28, lo8(active_str1) /* загрузить константу lo8(active_str1) в r28; следующая инструкция использует это значение. */
    ldi r29, hi8(active_str1) /* загрузить константу hi8(active_str1) в r29; следующая инструкция использует это значение. */
    rcall copy_z_to_y /* вызвать подпрограмму copy_z_to_y — скопировать NUL-завершённую строку из Z в Y, включая завершающий ноль. */
    ldi r30, lo8(candidate_str2) /* загрузить константу lo8(candidate_str2) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(candidate_str2) /* загрузить константу hi8(candidate_str2) в r31; следующая инструкция использует это значение. */
    ldi r28, lo8(active_str2) /* загрузить константу lo8(active_str2) в r28; следующая инструкция использует это значение. */
    ldi r29, hi8(active_str2) /* загрузить константу hi8(active_str2) в r29; следующая инструкция использует это значение. */
    rcall copy_z_to_y /* вызвать подпрограмму copy_z_to_y — скопировать NUL-завершённую строку из Z в Y, включая завершающий ноль. */

    /* Пересчитать точки сравнения относительно снимка TCNT1; таймер не останавливается. */
    rcall schedule_rebase /* вызвать подпрограмму schedule_rebase — перенести OCR1A/OCR1B относительно снимка TCNT1 и восстановить заданную фазу потоков. */
    clr r18 /* обнулить регистр r18 перед его повторным использованием. */
    sts restart_pending, r18 /* сохранить restart_pending в SRAM (r18). */
    sts control_slot_open, r18 /* сохранить control_slot_open в SRAM (r18). */
maybe_commit_return:
    ret /* вернуться к инструкции после соответствующего RCALL. */

/* После RESTART или принятия новых параметров заново вычислить начальные точки сравнения. */
schedule_rebase:
    in r22, _SFR_IO_ADDR(TCNT1L) /* Прочитать младший байт первым: это фиксирует старший байт TCNT1 в общей защёлке Timer1. */
    in r23, _SFR_IO_ADDR(TCNT1H) /* прочитать старший байт счётчика Timer1 (TCNT1H) в r23. */

#if TRACE_SCHEDULE
    /* Диагностический маркер используется только в сборке трассировки; PORTC в обычной прошивке не задействован. Маркер записывается после снимка TCNT1. Трассировщик фиксирует цикл записи и значение счётчика, чтобы восстановить эпоху расписания и активные параметры интервалов/строк. В обычную сборку этот блок не входит и на временной путь ISR не влияет. Формат: A5, snapshot_lo, snapshot_hi, T1_lo, T1_hi, T2_lo, T2_hi, len1, len2, затем байты обеих строк. */
    ldi r18, UART_TRACE_SCHEDULE_MARKER /* загрузить константу 0xA5 в r18; следующая инструкция использует это значение. */
    out _SFR_IO_ADDR(PORTC), r18 /* записать r18 в порт диагностического маркера расписания (PORTC). */
    out _SFR_IO_ADDR(PORTC), r22 /* записать r22 в порт диагностического маркера расписания (PORTC). */
    out _SFR_IO_ADDR(PORTC), r23 /* записать r23 в порт диагностического маркера расписания (PORTC). */
    lds r18, active_t1 /* прочитать из SRAM активный период T1 в r18. */
    out _SFR_IO_ADDR(PORTC), r18 /* записать r18 в порт диагностического маркера расписания (PORTC). */
    lds r18, active_t1+1 /* прочитать из SRAM активный период T1 в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    out _SFR_IO_ADDR(PORTC), r18 /* записать r18 в порт диагностического маркера расписания (PORTC). */
    lds r18, active_t2 /* прочитать из SRAM активный период T2 в r18. */
    out _SFR_IO_ADDR(PORTC), r18 /* записать r18 в порт диагностического маркера расписания (PORTC). */
    lds r18, active_t2+1 /* прочитать из SRAM активный период T2 в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    out _SFR_IO_ADDR(PORTC), r18 /* записать r18 в порт диагностического маркера расписания (PORTC). */
    lds r18, active_str1_len /* прочитать из SRAM длина активной строки 1 в r18. */
    out _SFR_IO_ADDR(PORTC), r18 /* записать r18 в порт диагностического маркера расписания (PORTC). */
    lds r18, active_str2_len /* прочитать из SRAM длина активной строки 2 в r18. */
    out _SFR_IO_ADDR(PORTC), r18 /* записать r18 в порт диагностического маркера расписания (PORTC). */

    lds r19, active_str1_len /* прочитать из SRAM длина активной строки 1 в r19. */
    ldi r30, lo8(active_str1) /* загрузить константу lo8(active_str1) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(active_str1) /* загрузить константу hi8(active_str1) в r31; следующая инструкция использует это значение. */
1:
    ld r24, Z+ /* Прочитать байт из SRAM по адресу Z в r24 и увеличить указатель на 1. */
    out _SFR_IO_ADDR(PORTC), r24 /* записать r24 в порт диагностического маркера расписания (PORTC). */
    dec r19 /* уменьшить на 1 (r19); флаги результата используются далее. */
    brne 1b /* если Z=0 (результат не равен нулю): перейти к 1b. */
    lds r19, active_str2_len /* прочитать из SRAM длина активной строки 2 в r19. */
    ldi r30, lo8(active_str2) /* загрузить константу lo8(active_str2) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(active_str2) /* загрузить константу hi8(active_str2) в r31; следующая инструкция использует это значение. */
2:
    ld r24, Z+ /* Прочитать байт из SRAM по адресу Z в r24 и увеличить указатель на 1. */
    out _SFR_IO_ADDR(PORTC), r24 /* записать r24 в порт диагностического маркера расписания (PORTC). */
    dec r19 /* уменьшить на 1 (r19); флаги результата используются далее. */
    brne 2b /* если Z=0 (результат не равен нулю): перейти к 2b. */
#endif

    /* Идеальный момент первой строки потока A равен началу эпохи плюс T1. */
    lds r18, active_t1 /* прочитать из SRAM активный период T1 в r18. */
    lds r19, active_t1+1 /* прочитать из SRAM активный период T1 в r19; смещение 1 выбирает следующий байт многобайтного значения. */
    subi r18, COMPARE_EARLY_A /* вычесть константу из регистра (r18, COMPARE_EARLY_A); флаги нужны для проверки переполнения или следующего байта. */
    sbci r19, 0 /* вычесть константу с учётом займа старшего байта (r19, 0); флаги нужны для проверки переполнения или следующего байта. */
    add r18, r22 /* сложить операнды (r18, r22); флаги нужны для проверки переполнения или следующего байта. */
    adc r19, r23 /* сложить операнды с переносом от младшего байта (r19, r23); флаги нужны для проверки переполнения или следующего байта. */
    out _SFR_IO_ADDR(OCR1AH), r19 /* записать r19 в старший байт Compare A (OCR1AH). */
    out _SFR_IO_ADDR(OCR1AL), r18 /* записать r18 в младший байт Compare A (OCR1AL). */

    /* Идеальный момент первой строки B: эпоха + phi + T2. Первое прерывание B только фиксирует фазу и прибавляет T2, не отправляя байт; поэтому исходная точка сравнения B соответствует фазе. */
    lds r24, active_str1_len /* прочитать из SRAM длина активной строки 1 в r24. */
    rcall calc_line_cycles /* вызвать подпрограмму calc_line_cycles — перевести длину строки в длительность передачи в тактах CPU. */
#if TASK2_PERIODIC_ONLY
    /* В варианте задания 2 ответов команд нет; резервируется только защитный промежуток между строками. */
    ldi r18, lo8(OUTPUT_GUARD_CYCLES) /* загрузить константу lo8(OUTPUT_GUARD_CYCLES) в r18; следующая инструкция использует это значение. */
    add r20, r18 /* сложить операнды (r20, r18); флаги нужны для проверки переполнения или следующего байта. */
    ldi r18, hi8(OUTPUT_GUARD_CYCLES) /* загрузить константу hi8(OUTPUT_GUARD_CYCLES) в r18; следующая инструкция использует это значение. */
    adc r21, r18 /* сложить операнды с переносом от младшего байта (r21, r18); флаги нужны для проверки переполнения или следующего байта. */
#else
    /* Сборка высокой сложности резервирует окно для OK/ERR после строки 1. */
    ldi r18, lo8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP) /* загрузить константу lo8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP) в r18; следующая инструкция использует это значение. */
    add r20, r18 /* сложить операнды (r20, r18); флаги нужны для проверки переполнения или следующего байта. */
    ldi r18, hi8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP) /* загрузить константу hi8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP) в r18; следующая инструкция использует это значение. */
    adc r21, r18 /* сложить операнды с переносом от младшего байта (r21, r18); флаги нужны для проверки переполнения или следующего байта. */
#endif
    subi r20, COMPARE_EARLY_PHASE /* вычесть константу из регистра (r20, COMPARE_EARLY_PHASE); флаги нужны для проверки переполнения или следующего байта. */
    sbci r21, 0 /* вычесть константу с учётом займа старшего байта (r21, 0); флаги нужны для проверки переполнения или следующего байта. */
    add r20, r22 /* сложить операнды (r20, r22); флаги нужны для проверки переполнения или следующего байта. */
    adc r21, r23 /* сложить операнды с переносом от младшего байта (r21, r23); флаги нужны для проверки переполнения или следующего байта. */
    out _SFR_IO_ADDR(OCR1BH), r21 /* записать r21 в старший байт Compare B (OCR1BH). */
    out _SFR_IO_ADDR(OCR1BL), r20 /* записать r20 в младший байт Compare B (OCR1BL). */

    rcall timer2_configure /* Остановить и перенастроить только Timer2 после завершения проверки кандидатных значений. */
    clr r18 /* Подготовить нулевой флаг timer2_started. */
    sts timer2_started, r18 /* Новый Timer2 начнёт работу после следующего фазового compare-B. */
    ldi r18, (1<<OCF2)|(1<<OCF1A)|(1<<OCF1B) /* Очистить старые флаги обоих аппаратных таймеров. */
    out _SFR_IO_ADDR(TIFR), r18 /* Запись единицы очищает соответствующие флаги сравнения. */
    ldi r18, (1<<OCIE2)|(1<<OCIE1A)|(1<<OCIE1B) /* Повторно разрешить Compare2 и одноразовый фазовый Compare B. */
    out _SFR_IO_ADDR(TIMSK), r18 /* Timer1 продолжает счёт; лишь после валидации меняются его сроки и Timer2. */
    ret /* Вернуться к планировщику после фиксации новой эпохи. */

/*
 * Вычислить беззнаковое расстояние от текущего снимка TCNT1 до ближайшей
 * точки сравнения. Результат — r25:r24. Снимок выполняется без CLI: если ISR
 * изменил Compare A или состояние запуска Timer2 внутри чтения, снимок повторяется.
 */
get_next_compare_delta:
    /* Сохранить используемые рабочие регистры вызывающего кода. */
    push r16
    push r17
    push r0

compare_delta_snapshot:
    /* Сначала прочитать точки сравнения, затем счётчик. Если ISR изменит OCR1A
       или запустит Timer2 между чтениями, проверка ниже повторит снимок.
       Главное отличие: здесь нет CLI, поэтому чтение сроков не задерживает IRQ. */
    lds r24, timer2_started
    mov r0, r24
    in r20, _SFR_IO_ADDR(OCR1AL)
    in r21, _SFR_IO_ADDR(OCR1AH)
    in r22, _SFR_IO_ADDR(OCR1BL)
    in r23, _SFR_IO_ADDR(OCR1BH)
    in r18, _SFR_IO_ADDR(TCNT1L)
    in r19, _SFR_IO_ADDR(TCNT1H)

    /* Проверить, что Compare A не обновился обработчиком между чтением срока
       и снимком счётчика. 16-разрядные регистры читаются в порядке low/high. */
    in r16, _SFR_IO_ADDR(OCR1AL)
    in r17, _SFR_IO_ADDR(OCR1AH)
    cp r20, r16
    cpc r21, r17
    brne compare_delta_snapshot

    /* Compare B меняет только timer2_started. Если запуск Timer2 произошёл
       внутри снимка, повторить его с новой временной моделью. */
    lds r24, timer2_started
    cp r24, r0
    brne compare_delta_snapshot
    mov r24, r0

    /* Timer1 A — ближайшее периодическое событие первого потока. */
    sub r20, r18
    sbc r21, r19
    tst r24
    brne compare_delta_timer2

    /* До однократного Compare B Timer2 ещё не запущен; сравнить A и B. */
    sub r22, r18
    sbc r23, r19
    rjmp compare_delta_choose_min

compare_delta_timer2:
    in r16, _SFR_IO_ADDR(OCR2)       /* Прочитать верхний предел счётчика Timer2. */
    in r17, _SFR_IO_ADDR(TCNT2)      /* Прочитать текущий счётчик Timer2 без запрета прерываний. */
    sub r16, r17                     /* Число оставшихся тиков Timer2 до TOP, если счётчик в CTC. */
    breq compare_delta_timer2_zero   /* Нулевое расстояние трактуется как уже наступивший/близкий срок. */
    dec r16                          /* Вычесть один тик для безопасной оценки при чтении рядом с фронтом предделителя. */
    mov r23, r16                     /* Подготовить верхний байт произведения (OCR2-TCNT2-1)*128. */
    lsr r23                          /* Умножение на 128: верхний байт равен diff/2. */
    clr r22                          /* Обнулить младший байт результата. */
    sbrc r16, 0                      /* Если diff нечётный, младший байт результата содержит старший бит. */
    ldi r22, 0x80                    /* Установить бит 7 младшего байта результата. */
    rjmp compare_delta_choose_min    /* Сравнить оценку срока Timer2 со сроком Timer1 A. */
compare_delta_timer2_zero:
    clr r22                          /* Консервативная оценка: событие Timer2 может быть немедленным. */
    clr r23                          /* Старший байт нулевого расстояния. */

compare_delta_choose_min:
    cp r20, r22                      /* Сравнить младшие байты двух оставшихся сроков. */
    cpc r21, r23                     /* Продолжить беззнаковое сравнение старших байтов. */
    brlo compare_delta_use_a         /* Если событие A раньше, вернуть его расстояние. */
    mov r24, r22                     /* Иначе вернуть младший байт другого срока. */
    mov r25, r23                     /* Вернуть старший байт другого срока. */
    rjmp compare_delta_return        /* Восстановить регистры и вернуться. */
compare_delta_use_a:
    mov r24, r20                     /* Вернуть младший байт расстояния до Timer1 A. */
    mov r25, r21                     /* Вернуть старший байт расстояния до Timer1 A. */
compare_delta_return:
    pop r0                           /* Восстановить r0: он сохраняется в начале снимка и используется как временный регистр. */
    pop r17                          /* Восстановить исходное значение r17. */
    pop r16                          /* Восстановить исходное значение r16. */
    ret                              /* Вернуть расстояние в r25:r24. */

