/*
 * Функциональный модуль: state_bss.inc
 * Назначение: Оперативное состояние: буферы команд, очередь ответов, указатель передачи и рабочие переменные проверки расписания.
 * Фрагмент включается в одну единицу трансляции firmware.S: общие метки SRAM
 * остаются видимыми без отдельной таблицы экспортируемых символов, а порядок
 * критичных инструкций и временные характеристики не меняются компоновкой.
 */
/* ------------------------------- SRAM BSS -------------------------------- */
.section .bss
cmd_len:                .skip 1 /* Текущая длина принимаемой команды. */
cmd_buffer:             .skip COMMAND_MAX + 1 /* Буфер команды USART; заканчивается нулём перед разбором. */

/* Очередью ответов пользуется только главный цикл; обработчики таймеров в неё не записывают. */
event_head:             .skip 1 /* Индекс чтения кольцевой очереди ответов. */
event_tail:             .skip 1 /* Индекс записи кольцевой очереди ответов. */
event_count:            .skip 1 /* Количество ответов, ожидающих отправки. */
event_overflow:         .skip 1 /* Признак переполнения очереди ответов. */
event_queue:            .skip EVENT_QUEUE_SIZE /* Кольцевая очередь кодов EV_OK/EV_ERROR; таймерные ISR в неё не пишут. */

/* Указатель TX изменяет только передатчик главного цикла. */
tx_ptr_lo:              .skip 1 /* Младший байт указателя текущей строки передачи. */
tx_ptr_hi:              .skip 1 /* Старший байт указателя текущей строки передачи. */
tx_kind:                .skip 1 /* tx_kind: 0 — свободен, 1 — строка 1, 2 — строка 2, 3 — ответ OK/ERR; Состояние передатчика: 0 — свободен, 1/2 — периодические строки, 3 — ответ команды. */
control_slot_open:      .skip 1 /* Флаг доступности зарезервированного окна для ответа OK/ERR. */
restart_pending:        .skip 1 /* Кандидатная конфигурация принята; ожидается безопасное применение. */
timer2_started:         .skip 1 /* Флаг: одноразовый Compare B запустил независимый Timer2; его Compare Match формирует pong. */

/* Рабочие переменные общие только для разбора команд и проверки расписания в главном цикле. */
test_t1:                .skip 2 /* Временное значение T1, используемое при расчёте допустимости. */
test_t2:                .skip 2 /* Временное значение T2, используемое при расчёте допустимости. */
test_len1:              .skip 1 /* Тестовая длина первой строки при проверке расписания. */
test_len2:              .skip 1 /* Тестовая длина второй строки при проверке расписания. */
tx1_cycles:             .skip 2 /* Расчётная длительность передачи первой строки в тактах CPU. */
tx2_cycles:             .skip 2 /* Расчётная длительность передачи второй строки в тактах CPU. */
required_g:             .skip 2 /* Минимально необходимый НОД периодов с учётом передачи строк и защитных окон. */
gcd_a:                  .skip 2 /* Рабочий операнд a алгоритма двоичного НОД. */
gcd_b:                  .skip 2 /* Рабочий операнд b алгоритма двоичного НОД. */
gcd_result:             .skip 2 /* Результат расчёта gcd(T1,T2). */
pair_value1:            .skip 2 /* Первое число команды T=a,b, сохранённое после разбора. */
pair_value2:            .skip 2 /* Второе число команды T=a,b, сохранённое после разбора. */
