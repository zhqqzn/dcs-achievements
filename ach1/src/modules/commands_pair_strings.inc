/*
 * Функциональный модуль: commands_pair_strings.inc
 * Назначение: Разбор пары чисел и изменение пользовательских строк с предварительной проверкой длины и расписания.
 * Фрагмент включается в одну единицу трансляции firmware.S: общие метки SRAM
 * остаются видимыми без отдельной таблицы экспортируемых символов, а порядок
 * критичных инструкций и временные характеристики не меняются компоновкой.
 */
/* Найти запятую, разобрать оба uint16 и установить r23=1 при успехе. */
parse_pair_command:
    clr r23 /* обнулить регистр r23 перед его повторным использованием. */
    ldi r30, lo8(cmd_buffer+2) /* загрузить константу lo8(cmd_buffer+2) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(cmd_buffer+2) /* загрузить константу hi8(cmd_buffer+2) в r31; следующая инструкция использует это значение. */
parse_pair_find_comma:
    ld r18, Z /* Прочитать байт из SRAM по адресу Z в r18; указатель не меняется. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq parse_pair_return /* если Z=1 (результат равен нулю): перейти к parse_pair_return. */
    cpi r18, ',' /* сравнить r18 с код символа ',', не сохраняя результат вычитания; далее проверяются флаги. */
    breq parse_pair_comma_found /* если Z=1 (результат равен нулю): перейти к parse_pair_comma_found. */
    adiw r30, 1 /* прибавить константу к 16-битной паре (r30, 1); флаги результата используются далее. */
    rjmp parse_pair_find_comma /* безусловно передать управление на метку parse_pair_find_comma; выполнение продолжится с указанной метки. */
parse_pair_comma_found:
    mov r26, r30 /* скопировать значение r26, r30; исходный регистр не изменяется. */
    mov r27, r31 /* скопировать значение r27, r31; исходный регистр не изменяется. */
    st Z, r1 /* Записать r1 в SRAM по адресу Z; указатель не меняется. */
    ldi r30, lo8(cmd_buffer+2) /* загрузить константу lo8(cmd_buffer+2) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(cmd_buffer+2) /* загрузить константу hi8(cmd_buffer+2) в r31; следующая инструкция использует это значение. */
    rcall parse_decimal_u16 /* вызвать подпрограмму parse_decimal_u16 — преобразовать десятичное NUL-завершённое число в uint16, проверяя переполнение до умножения. */
    tst r23 /* проверить r23 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq parse_pair_restore_bad /* если Z=1 (результат равен нулю): перейти к parse_pair_restore_bad. */
    sts pair_value1, r24 /* сохранить pair_value1 в SRAM (r24). */
    sts pair_value1+1, r25 /* сохранить pair_value1+1 в SRAM (r25). */
    ldi r18, ',' /* загрузить код символа ',' в r18; следующая инструкция использует это значение. */
    st X, r18 /* Записать r18 в SRAM по адресу X; указатель не меняется. */
    adiw r26, 1 /* прибавить константу к 16-битной паре (r26, 1); флаги результата используются далее. */
    mov r30, r26 /* скопировать значение r30, r26; исходный регистр не изменяется. */
    mov r31, r27 /* скопировать значение r31, r27; исходный регистр не изменяется. */
    rcall parse_decimal_u16 /* вызвать подпрограмму parse_decimal_u16 — преобразовать десятичное NUL-завершённое число в uint16, проверяя переполнение до умножения. */
    tst r23 /* проверить r23 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq parse_pair_return /* если Z=1 (результат равен нулю): перейти к parse_pair_return. */
    sts pair_value2, r24 /* сохранить pair_value2 в SRAM (r24). */
    sts pair_value2+1, r25 /* сохранить pair_value2+1 в SRAM (r25). */
    ldi r23, 1 /* загрузить константу 1 в r23; следующая инструкция использует это значение. */
    ret /* вернуться к инструкции после соответствующего RCALL. */
parse_pair_restore_bad:
    ldi r18, ',' /* загрузить код символа ',' в r18; следующая инструкция использует это значение. */
    st X, r18 /* Записать r18 в SRAM по адресу X; указатель не меняется. */
parse_pair_return:
    clr r23 /* обнулить регистр r23 перед его повторным использованием. */
    ret /* вернуться к инструкции после соответствующего RCALL. */

parse_string_command:
    lds r18, cmd_buffer+1 /* прочитать из SRAM буфер команды в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    cpi r18, '1' /* сравнить r18 с код символа '1', не сохраняя результат вычитания; далее проверяются флаги. */
    breq parse_string1 /* если Z=1 (результат равен нулю): перейти к parse_string1. */
    cpi r18, '2' /* сравнить r18 с код символа '2', не сохраняя результат вычитания; далее проверяются флаги. */
    breq parse_string2 /* если Z=1 (результат равен нулю): перейти к parse_string2. */
    rjmp command_error /* безусловно передать управление на метку command_error; выполнение продолжится с указанной метки. */
parse_string1:
    ldi r18, 1 /* загрузить константу 1 в r18; следующая инструкция использует это значение. */
    sts temp_string_len, r18 /* Временная метка используется при поиске разделителя пары; после проверки она восстанавливается; сохранить temp_string_len в SRAM (r18). */
    rjmp parse_string_equal /* безусловно передать управление на метку parse_string_equal; выполнение продолжится с указанной метки. */
parse_string2:
    ldi r18, 2 /* загрузить константу 2 в r18; следующая инструкция использует это значение. */
    sts temp_string_len, r18 /* сохранить temp_string_len в SRAM (r18). */
parse_string_equal:
    lds r18, cmd_buffer+2 /* прочитать из SRAM буфер команды в r18; смещение 2 выбирает следующий байт многобайтного значения. */
    cpi r18, '=' /* сравнить r18 с код символа '=', не сохраняя результат вычитания; далее проверяются флаги. */
    BRNE_LONG command_error /* расширенный переход при Z=0; цель — command_error. */
    ldi r30, lo8(cmd_buffer+3) /* загрузить константу lo8(cmd_buffer+3) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(cmd_buffer+3) /* загрузить константу hi8(cmd_buffer+3) в r31; следующая инструкция использует это значение. */
    ldi r28, lo8(temp_string) /* загрузить константу lo8(temp_string) в r28; следующая инструкция использует это значение. */
    ldi r29, hi8(temp_string) /* загрузить константу hi8(temp_string) в r29; следующая инструкция использует это значение. */
    clr r19 /* счётчик длины текста очищается перед накоплением символов; обнулить регистр r19 перед его повторным использованием. */
parse_string_copy:
    ld r18, Z+ /* Прочитать байт из SRAM по адресу Z в r18 и увеличить указатель на 1. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq parse_string_append_crlf /* если Z=1 (результат равен нулю): перейти к parse_string_append_crlf. */
    cpi r19, MAX_TEXT_LEN /* сравнить r19 с константу MAX_TEXT_LEN, не сохраняя результат вычитания; далее проверяются флаги. */
    brlo parse_string_char_fits /* если C=1 (меньше без знака): перейти к parse_string_char_fits. */
    rjmp command_error /* безусловно передать управление на метку command_error; выполнение продолжится с указанной метки. */
parse_string_char_fits:
    st Y+, r18 /* Записать r18 по адресу Y и увеличить указатель на 1. */
    inc r19 /* увеличить на 1 (r19); флаги результата используются далее. */
    rjmp parse_string_copy /* безусловно передать управление на метку parse_string_copy; выполнение продолжится с указанной метки. */
parse_string_append_crlf:
    ldi r18, 13 /* загрузить константу 13 в r18; следующая инструкция использует это значение. */
    st Y+, r18 /* Записать r18 по адресу Y и увеличить указатель на 1. */
    ldi r18, 10 /* загрузить константу 10 в r18; следующая инструкция использует это значение. */
    st Y+, r18 /* Записать r18 по адресу Y и увеличить указатель на 1. */
    clr r18 /* обнулить регистр r18 перед его повторным использованием. */
    st Y, r18 /* Записать r18 в SRAM по адресу Y; указатель не меняется. */
    mov r18, r19 /* скопировать значение r18, r19; исходный регистр не изменяется. */
    inc r18 /* увеличить на 1 (r18); флаги результата используются далее. */
    inc r18 /* увеличить на 1 (r18); флаги результата используются далее. */
    sts temp_string_len, r18 /* сохранить temp_string_len в SRAM (r18). */

    /* Проверить кандидатные интервалы с новой длиной строки до фиксации изменения. */
    lds r18, cmd_buffer+1 /* прочитать из SRAM буфер команды в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    cpi r18, '1' /* сравнить r18 с код символа '1', не сохраняя результат вычитания; далее проверяются флаги. */
    brne parse_string_test_2 /* если Z=0 (результат не равен нулю): перейти к parse_string_test_2. */
    lds r18, temp_string_len /* прочитать из SRAM длина временной строки в r18. */
    sts request_len1, r18 /* сохранить request_len1 в SRAM (r18). */
    lds r18, candidate_str2_len /* прочитать из SRAM длина строки-кандидата 2 в r18. */
    sts request_len2, r18 /* сохранить request_len2 в SRAM (r18). */
    rjmp parse_string_validate /* безусловно передать управление на метку parse_string_validate; выполнение продолжится с указанной метки. */
parse_string_test_2:
    lds r18, candidate_str1_len /* прочитать из SRAM длина строки-кандидата 1 в r18. */
    sts request_len1, r18 /* сохранить request_len1 в SRAM (r18). */
    lds r18, temp_string_len /* прочитать из SRAM длина временной строки в r18. */
    sts request_len2, r18 /* сохранить request_len2 в SRAM (r18). */
parse_string_validate:
    lds r24, candidate_t1
    lds r25, candidate_t1+1
    lds r22, candidate_t2
    lds r23, candidate_t2+1
    lds r21, request_len1
    lds r20, request_len2
    rcall config_validate /* Проверить интервалы и предложенные длины через регистровый интерфейс. */
    tst r24 /* проверить r24 без изменения самого регистра; результат задаёт флаги Z/N. */
    brne parse_string_commit /* если Z=0 (результат не равен нулю): перейти к parse_string_commit. */
    rjmp command_error /* безусловно передать управление на метку command_error; выполнение продолжится с указанной метки. */
parse_string_commit:
    lds r18, cmd_buffer+1 /* прочитать из SRAM буфер команды в r18; смещение 1 выбирает следующий байт многобайтного значения. */
    cpi r18, '1' /* сравнить r18 с код символа '1', не сохраняя результат вычитания; далее проверяются флаги. */
    brne parse_string_commit_2 /* если Z=0 (результат не равен нулю): перейти к parse_string_commit_2. */
    ldi r30, lo8(temp_string) /* загрузить константу lo8(temp_string) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(temp_string) /* загрузить константу hi8(temp_string) в r31; следующая инструкция использует это значение. */
    ldi r28, lo8(candidate_str1) /* загрузить константу lo8(candidate_str1) в r28; следующая инструкция использует это значение. */
    ldi r29, hi8(candidate_str1) /* загрузить константу hi8(candidate_str1) в r29; следующая инструкция использует это значение. */
    rcall copy_z_to_y /* вызвать подпрограмму copy_z_to_y — скопировать NUL-завершённую строку из Z в Y, включая завершающий ноль. */
    lds r18, temp_string_len /* прочитать из SRAM длина временной строки в r18. */
    sts candidate_str1_len, r18 /* сохранить candidate_str1_len в SRAM (r18). */
    rjmp command_accept_restart /* безусловно передать управление на метку command_accept_restart; выполнение продолжится с указанной метки. */
parse_string_commit_2:
    ldi r30, lo8(temp_string) /* загрузить константу lo8(temp_string) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(temp_string) /* загрузить константу hi8(temp_string) в r31; следующая инструкция использует это значение. */
    ldi r28, lo8(candidate_str2) /* загрузить константу lo8(candidate_str2) в r28; следующая инструкция использует это значение. */
    ldi r29, hi8(candidate_str2) /* загрузить константу hi8(candidate_str2) в r29; следующая инструкция использует это значение. */
    rcall copy_z_to_y /* вызвать подпрограмму copy_z_to_y — скопировать NUL-завершённую строку из Z в Y, включая завершающий ноль. */
    lds r18, temp_string_len /* прочитать из SRAM длина временной строки в r18. */
    sts candidate_str2_len, r18 /* сохранить candidate_str2_len в SRAM (r18). */
    rjmp command_accept_restart /* безусловно передать управление на метку command_accept_restart; выполнение продолжится с указанной метки. */
