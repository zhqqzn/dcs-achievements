/*
 * Функциональный модуль: branch_macros.inc
 * Назначение: Условные переходы AVR имеют ограниченную дальность. Макросы ниже расширяют переход, не меняя смысл условия.
 * Фрагмент включается в одну единицу трансляции firmware.S: общие метки SRAM
 * остаются видимыми без отдельной таблицы экспортируемых символов, а порядок
 * критичных инструкций и временные характеристики не меняются компоновкой.
 */
/* Условные переходы BRxx имеют ограниченную дальность — около 64 слов. */
.macro BREQ_LONG target
    brne 1f /* если Z=0 (результат не равен нулю): перейти к 1f. */
    rjmp \target /* безусловно передать управление на метку \target; выполнение продолжится с указанной метки. */
1:
.endm
.macro BRNE_LONG target
    breq 1f /* если Z=1 (результат равен нулю): перейти к 1f. */
    rjmp \target /* безусловно передать управление на метку \target; выполнение продолжится с указанной метки. */
1:
.endm
.macro BRCS_LONG target
    brcc 1f /* если C=0 (нет переноса): перейти к 1f. */
    rjmp \target /* безусловно передать управление на метку \target; выполнение продолжится с указанной метки. */
1:
.endm
.macro BRLO_LONG target
    brsh 1f /* если C=0 (не меньше без знака): перейти к 1f. */
    rjmp \target /* безусловно передать управление на метку \target; выполнение продолжится с указанной метки. */
1:
.endm
.macro BRSH_LONG target
    brlo 1f /* если C=1 (меньше без знака): перейти к 1f. */
    rjmp \target /* безусловно передать управление на метку \target; выполнение продолжится с указанной метки. */
1:
.endm
