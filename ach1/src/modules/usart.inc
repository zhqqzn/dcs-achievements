/*
 * Функциональный модуль: usart.inc
 * Назначение: Драйвер USART: инициализация формата, опрос RX и передача оставшихся байтов без отдельного USART ISR.
 * Фрагмент включается в одну единицу трансляции firmware.S: общие метки SRAM
 * остаются видимыми без отдельной таблицы экспортируемых символов, а порядок
 * критичных инструкций и временные характеристики не меняются компоновкой.
 */
/* ------------------------------- USART ------------------------------------ */
uart_init:
    ldi r16, (1<<U2X) /* подготовить битовую маску настройки в r16; следующая инструкция использует это значение. */
    out _SFR_IO_ADDR(UCSRA), r16 /* записать r16 в статус/управление USART (UCSRA). */
    /* Сначала задать формат кадра 8N1, затем делитель скорости; это избегает устаревших параметров кадра в некоторых моделях USART simavr 1.6. */
    ldi r16, (1<<URSEL)|(1<<UCSZ1)|(1<<UCSZ0) /* подготовить битовую маску настройки в r16; следующая инструкция использует это значение. */
    out _SFR_IO_ADDR(UCSRC), r16 /* записать r16 в формат кадра USART (UCSRC). */
    clr r16 /* обнулить регистр r16 перед его повторным использованием. */
    out _SFR_IO_ADDR(UBRRH), r16 /* записать r16 в старший байт делителя USART (UBRRH). */
    ldi r16, UART_UBRR_VALUE /* загрузить константу UART_UBRR_VALUE в r16; следующая инструкция использует это значение. */
    out _SFR_IO_ADDR(UBRRL), r16 /* записать r16 в младший байт делителя USART (UBRRL). */
#if TASK2_PERIODIC_ONLY
    ldi r16, (1<<TXEN) /* подготовить битовую маску настройки в r16; следующая инструкция использует это значение. */
#else
    /* Приём опрашивается главным циклом; RX-прерывание не может задержать периодическое событие. */
    ldi r16, (1<<RXEN)|(1<<TXEN) /* подготовить битовую маску настройки в r16; следующая инструкция использует это значение. */
#endif
    out _SFR_IO_ADDR(UCSRB), r16 /* записать r16 в разрешения USART (UCSRB). */
    ret /* вернуться к инструкции после соответствующего RCALL. */

/* Опросить RXC и передать принятый байт обработчику команды. */
uart_poll_rx:
    in r18, _SFR_IO_ADDR(UCSRA) /* прочитать статус/управление USART (UCSRA) в r18. */
    sbrs r18, RXC /* пропустить следующую инструкцию, если бит RXC регистра r18 равен 1. */
    ret /* вернуться к инструкции после соответствующего RCALL. */
    in r24, _SFR_IO_ADDR(UDR) /* прочитать регистр данных USART (UDR) в r24. */
    rcall process_rx_char /* вызвать подпрограмму process_rx_char — собрать команду до CR, не позволяя буферу выйти за пределы. */
    ret /* вернуться к инструкции после соответствующего RCALL. */

/* Передатчик главного цикла опрашивает UDRE и записывает очередной байт только при готовности регистра. Прерывание UDRE отключено: его обработчик мог бы задержать критическое прерывание сравнения и нарушить допуск четырёх тактов. Код опроса может быть прерван обработчиками таймера. */
uart_tx_poll:
    lds r18, tx_kind /* прочитать из SRAM состояние передачи в r18. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq uart_tx_poll_return /* если Z=1 (результат равен нулю): перейти к uart_tx_poll_return. */
    in r18, _SFR_IO_ADDR(UCSRA) /* прочитать статус/управление USART (UCSRA) в r18. */
    sbrs r18, UDRE /* пропустить следующую инструкцию, если бит UDRE регистра r18 равен 1. */
    rjmp uart_tx_poll_return /* безусловно передать управление на метку uart_tx_poll_return; выполнение продолжится с указанной метки. */
    lds r30, tx_ptr_lo /* прочитать из SRAM младший байт указателя передачи в r30. */
    lds r31, tx_ptr_hi /* прочитать из SRAM старший байт указателя передачи в r31. */
    ld r24, Z /* Прочитать байт из SRAM по адресу Z в r24; указатель не меняется. */
    tst r24 /* проверить r24 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq uart_tx_poll_return /* если Z=1 (результат равен нулю): перейти к uart_tx_poll_return. */
    out _SFR_IO_ADDR(UDR), r24 /* записать r24 в регистр данных USART (UDR). */
#if TRACE_SCHEDULE
    /* Только для трассировки: отметить исходящие записи, отличая их от чтения UDR при приёме. */
    out _SFR_IO_ADDR(PORTB), r24 /* записать r24 в диагностический порт зеркалирования TX (PORTB). */
#endif
    /* Флаг TXC очищается записью единицы. Сбрасывать его нужно для каждого байта: иначе в моделях, где UDRE поднимается в конце кадра, TXC может ещё описывать предыдущий байт, пока следующий только помещается в UDR. */
    ldi r19, (1<<TXC)|(1<<U2X) /* подготовить битовую маску настройки в r19; следующая инструкция использует это значение. */
    out _SFR_IO_ADDR(UCSRA), r19 /* записать r19 в статус/управление USART (UCSRA). */
    adiw r30, 1 /* прибавить константу к 16-битной паре (r30, 1); флаги результата используются далее. */
    sts tx_ptr_lo, r30 /* сохранить tx_ptr_lo в SRAM (r30). */
    sts tx_ptr_hi, r31 /* сохранить tx_ptr_hi в SRAM (r31). */
uart_tx_poll_return:
    ret /* вернуться к инструкции после соответствующего RCALL. */

/*
 * Одного TXC недостаточно, чтобы считать строку полностью переданной: флаг может
 * относиться к предыдущему кадру, пока главный цикл ещё ожидает другие байты
 * в очереди. Завершать строку только у NUL-терминатора, когда
 * TXC подтверждает выход последнего кадра из сдвигового регистра.
 */
service_tx_complete:
    lds r18, tx_kind /* прочитать из SRAM состояние передачи в r18. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq service_tx_complete_return /* если Z=1 (результат равен нулю): перейти к service_tx_complete_return. */
    in r19, _SFR_IO_ADDR(UCSRA) /* прочитать статус/управление USART (UCSRA) в r19. */
    sbrs r19, TXC /* пропустить следующую инструкцию, если бит TXC регистра r19 равен 1. */
    rjmp service_tx_complete_return /* безусловно передать управление на метку service_tx_complete_return; выполнение продолжится с указанной метки. */
    lds r30, tx_ptr_lo /* прочитать из SRAM младший байт указателя передачи в r30. */
    lds r31, tx_ptr_hi /* прочитать из SRAM старший байт указателя передачи в r31. */
    ld r20, Z /* Прочитать байт из SRAM по адресу Z в r20; указатель не меняется. */
    tst r20 /* проверить r20 без изменения самого регистра; результат задаёт флаги Z/N. */
    brne service_tx_complete_return /* если Z=0 (результат не равен нулю): перейти к service_tx_complete_return. */
    clr r19 /* обнулить регистр r19 перед его повторным использованием. */
    sts tx_kind, r19 /* сохранить tx_kind в SRAM (r19). */
    cpi r18, 1 /* сравнить r18 с константу 1, не сохраняя результат вычитания; далее проверяются флаги. */
    breq service_tx_complete_open_slot /* если Z=1 (результат равен нулю): перейти к service_tx_complete_open_slot. */
    sts control_slot_open, r19 /* сохранить control_slot_open в SRAM (r19). */
    rjmp service_tx_complete_return /* безусловно передать управление на метку service_tx_complete_return; выполнение продолжится с указанной метки. */
service_tx_complete_open_slot:
    ldi r19, 1 /* загрузить константу 1 в r19; следующая инструкция использует это значение. */
    sts control_slot_open, r19 /* сохранить control_slot_open в SRAM (r19). */
service_tx_complete_return:
    ret /* вернуться к инструкции после соответствующего RCALL. */
