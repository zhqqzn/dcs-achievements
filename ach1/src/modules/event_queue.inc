/*
 * Функциональный модуль: event_queue.inc
 * Назначение: Кольцевая очередь ответов и обработка переполнения. Таймерные обработчики не используют эту очередь.
 * Фрагмент включается в одну единицу трансляции firmware.S: общие метки SRAM
 * остаются видимыми без отдельной таблицы экспортируемых символов, а порядок
 * критичных инструкций и временные характеристики не меняются компоновкой.
 */
/* ------------------------------ Event queue ------------------------------- */
/* Очередью пользуется только главный цикл; таймерные ISR не добавляют события, поэтому CLI не нужен. */
event_enqueue:
    push r18 /* сохранить r18 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r19 /* сохранить r19 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r30 /* сохранить r30 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r31 /* сохранить r31 на стеке, чтобы не потерять значение при вызове/прерывании. */
    lds r18, event_count /* прочитать из SRAM счётчик очереди в r18. */
    cpi r18, EVENT_QUEUE_SIZE /* сравнить r18 с константу EVENT_QUEUE_SIZE, не сохраняя результат вычитания; далее проверяются флаги. */
    brsh event_queue_full /* если C=0 (не меньше без знака): перейти к event_queue_full. */
    lds r19, event_tail /* прочитать из SRAM индекс записи очереди в r19. */
    ldi r30, lo8(event_queue) /* загрузить константу lo8(event_queue) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(event_queue) /* загрузить константу hi8(event_queue) в r31; следующая инструкция использует это значение. */
    add r30, r19 /* сложить операнды (r30, r19); флаги нужны для проверки переполнения или следующего байта. */
    adc r31, r1 /* сложить операнды с переносом от младшего байта (r31, r1); флаги нужны для проверки переполнения или следующего байта. */
    st Z, r24 /* Записать r24 в SRAM по адресу Z; указатель не меняется. */
    inc r19 /* увеличить на 1 (r19); флаги результата используются далее. */
    andi r19, EVENT_QUEUE_MASK /* выполнить побитовое И с маской (r19, EVENT_QUEUE_MASK); обычно ограничивает индекс кольцевой очереди. */
    sts event_tail, r19 /* сохранить event_tail в SRAM (r19). */
    inc r18 /* увеличить на 1 (r18); флаги результата используются далее. */
    sts event_count, r18 /* сохранить event_count в SRAM (r18). */
    rjmp event_enqueue_exit /* безусловно передать управление на метку event_enqueue_exit; выполнение продолжится с указанной метки. */
event_queue_full:
    ldi r18, 1 /* загрузить константу 1 в r18; следующая инструкция использует это значение. */
    sts event_overflow, r18 /* сохранить event_overflow в SRAM (r18). */
event_enqueue_exit:
    pop r31 /* восстановить прежнее значение r31 со стека. */
    pop r30 /* восстановить прежнее значение r30 со стека. */
    pop r19 /* восстановить прежнее значение r19 со стека. */
    pop r18 /* восстановить прежнее значение r18 со стека. */
    ret /* вернуться к инструкции после соответствующего RCALL. */

event_dequeue:
    push r18 /* сохранить r18 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r19 /* сохранить r19 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r30 /* сохранить r30 на стеке, чтобы не потерять значение при вызове/прерывании. */
    push r31 /* сохранить r31 на стеке, чтобы не потерять значение при вызове/прерывании. */
    clr r24 /* обнулить регистр r24 перед его повторным использованием. */
    lds r18, event_count /* прочитать из SRAM счётчик очереди в r18. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq event_dequeue_exit /* если Z=1 (результат равен нулю): перейти к event_dequeue_exit. */
    lds r19, event_head /* прочитать из SRAM индекс чтения очереди в r19. */
    ldi r30, lo8(event_queue) /* загрузить константу lo8(event_queue) в r30; следующая инструкция использует это значение. */
    ldi r31, hi8(event_queue) /* загрузить константу hi8(event_queue) в r31; следующая инструкция использует это значение. */
    add r30, r19 /* сложить операнды (r30, r19); флаги нужны для проверки переполнения или следующего байта. */
    adc r31, r1 /* сложить операнды с переносом от младшего байта (r31, r1); флаги нужны для проверки переполнения или следующего байта. */
    ld r24, Z /* Прочитать байт из SRAM по адресу Z в r24; указатель не меняется. */
    inc r19 /* увеличить на 1 (r19); флаги результата используются далее. */
    andi r19, EVENT_QUEUE_MASK /* выполнить побитовое И с маской (r19, EVENT_QUEUE_MASK); обычно ограничивает индекс кольцевой очереди. */
    sts event_head, r19 /* сохранить event_head в SRAM (r19). */
    dec r18 /* уменьшить на 1 (r18); флаги результата используются далее. */
    sts event_count, r18 /* сохранить event_count в SRAM (r18). */
event_dequeue_exit:
    pop r31 /* восстановить прежнее значение r31 со стека. */
    pop r30 /* восстановить прежнее значение r30 со стека. */
    pop r19 /* восстановить прежнее значение r19 со стека. */
    pop r18 /* восстановить прежнее значение r18 со стека. */
    ret /* вернуться к инструкции после соответствующего RCALL. */

handle_event_overflow:
    lds r18, event_overflow /* прочитать из SRAM флаг переполнения очереди в r18. */
    tst r18 /* проверить r18 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq handle_event_overflow_return /* если Z=1 (результат равен нулю): перейти к handle_event_overflow_return. */
    lds r18, event_count /* прочитать из SRAM счётчик очереди в r18. */
    cpi r18, EVENT_QUEUE_SIZE /* сравнить r18 с константу EVENT_QUEUE_SIZE, не сохраняя результат вычитания; далее проверяются флаги. */
    brsh handle_event_overflow_return /* если C=0 (не меньше без знака): перейти к handle_event_overflow_return. */
    clr r18 /* обнулить регистр r18 перед его повторным использованием. */
    sts event_overflow, r18 /* сохранить event_overflow в SRAM (r18). */
    ldi r24, EV_ERROR /* загрузить константу EV_ERROR в r24; следующая инструкция использует это значение. */
    rcall event_enqueue /* вызвать подпрограмму event_enqueue — поместить код ответа в кольцевую очередь; используется главным циклом. */
handle_event_overflow_return:
    ret /* вернуться к инструкции после соответствующего RCALL. */
