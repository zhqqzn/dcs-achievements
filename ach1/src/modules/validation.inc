/*
 * Функциональный модуль: validation.inc
 * Назначение: Проверка расписания: длительности строк, необходимый НОД периодов, фазовые промежутки и двоичный алгоритм Евклида.
 * Фрагмент включается в одну единицу трансляции firmware.S: общие метки SRAM
 * остаются видимыми без отдельной таблицы экспортируемых символов, а порядок
 * критичных инструкций и временные характеристики не меняются компоновкой.
 */
/* ---------------------- Admission test: schedule feasibility -------------- */
/*
 * Условия, принятые в этой реализации:
 *   tx1 = len1 * 1360 cycles; tx2 = len2 * 1360 cycles.
 *   One status response (worst case "ERR\r\n" = 6800 cycles) is reserved
 *   после каждой строки 1; ещё 512 тактов отводятся на запуск и подготовку.
 *   После строки 2 оставляется защитный промежуток не менее 32 тактов.
 *
 * Следовательно, gcd(T1,T2) >= tx1 + tx2 + 6800 + 512 + 32.
 * Фаза phi = tx1 + 6800 + 512; при этом оба промежутка удовлетворяют принятому условию.
 * Это строже нижней границы задания 2, где учитываются только периодические строки, поскольку
 * в задании 3 по тому же USART нужно передавать ответы OK/ERR.
 *
 * Возврат: r24=1 — расписание допустимо, r24=0 — недопустимо. Прерывания остаются разрешёнными.
 */
config_validate:
    /* Аппаратный Timer2 работает с фиксированным делителем 128: период должен быть кратен 128 и не превышать 256*128 циклов. */
    lds r20, test_t2 /* Прочитать младший байт кандидатного периода Timer2. */
    andi r20, 0x7f /* Младшие семь бит должны быть нулевыми. */
    BRNE_LONG config_invalid /* Некратный 128 период Timer2 нельзя задать этим режимом CTC. */
    lds r20, test_t2+1 /* Проверить старший байт после проверки кратности. */
    cpi r20, hi8(TIMER2_MAX_INTERVAL) /* Сравнить со старшим байтом предельного периода 32768. */
    brlo config_t2_range_ok /* Меньшее старшее значение заведомо лежит в диапазоне. */
    BRNE_LONG config_invalid /* Значение выше 32768 выходит за возможности 8-разрядного счётчика. */
    lds r20, test_t2 /* При старшем байте 0x80 младший байт обязан быть нулём. */
    tst r20 /* Проверить младший байт максимального периода. */
    BRNE_LONG config_invalid /* Отклонить значение больше 32768. */
config_t2_range_ok:
    lds r24, test_len1 /* прочитать из SRAM тестовая длина строки 1 в r24. */
    rcall calc_line_cycles /* вызвать подпрограмму calc_line_cycles — перевести длину строки в длительность передачи в тактах CPU. */
    sts tx1_cycles, r20 /* сохранить tx1_cycles в SRAM (r20). */
    sts tx1_cycles+1, r21 /* сохранить tx1_cycles+1 в SRAM (r21). */
    lds r24, test_len2 /* прочитать из SRAM тестовая длина строки 2 в r24. */
    rcall calc_line_cycles /* вызвать подпрограмму calc_line_cycles — перевести длину строки в длительность передачи в тактах CPU. */
    sts tx2_cycles, r20 /* сохранить tx2_cycles в SRAM (r20). */
    sts tx2_cycles+1, r21 /* сохранить tx2_cycles+1 в SRAM (r21). */

    /* required_g суммирует длительности обеих строк, ответа OK/ERR, подготовки и защитного промежутка. */
    lds r18, tx1_cycles /* прочитать из SRAM длительность передачи строки 1 в r18. */
    lds r19, tx1_cycles+1 /* прочитать из SRAM длительность передачи строки 1 в r19; смещение 1 выбирает следующий байт многобайтного значения. */
    lds r20, tx2_cycles /* прочитать из SRAM длительность передачи строки 2 в r20. */
    lds r21, tx2_cycles+1 /* прочитать из SRAM длительность передачи строки 2 в r21; смещение 1 выбирает следующий байт многобайтного значения. */
    add r18, r20 /* сложить операнды (r18, r20); флаги нужны для проверки переполнения или следующего байта. */
    adc r19, r21 /* сложить операнды с переносом от младшего байта (r19, r21); флаги нужны для проверки переполнения или следующего байта. */
    BRCS_LONG config_invalid /* расширенный переход при C=1; цель — config_invalid. */
    ldi r20, lo8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP + OUTPUT_GUARD_CYCLES) /* загрузить константу lo8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP + OUTPUT_GUARD_CYCLES) в r20; следующая инструкция использует это значение. */
    add r18, r20 /* сложить операнды (r18, r20); флаги нужны для проверки переполнения или следующего байта. */
    ldi r20, hi8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP + OUTPUT_GUARD_CYCLES) /* загрузить константу hi8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP + OUTPUT_GUARD_CYCLES) в r20; следующая инструкция использует это значение. */
    adc r19, r20 /* сложить операнды с переносом от младшего байта (r19, r20); флаги нужны для проверки переполнения или следующего байта. */
    BRCS_LONG config_invalid /* расширенный переход при C=1; цель — config_invalid. */
    sts required_g, r18 /* сохранить required_g в SRAM (r18). */
    sts required_g+1, r19 /* сохранить required_g+1 в SRAM (r19). */

    /* НОД не может быть больше каждого периода; заведомо короткий период можно отклонить сразу. */
    lds r20, test_t1 /* прочитать из SRAM тестовый T1 в r20. */
    lds r21, test_t1+1 /* прочитать из SRAM тестовый T1 в r21; смещение 1 выбирает следующий байт многобайтного значения. */
    cp r20, r18 /* сравнить операнды r20, r18; выставить флаги сравнения. */
    cpc r21, r19 /* сравнить операнды r21, r19; учесть входящий перенос для старшего байта. */
    BRLO_LONG config_invalid /* расширенный переход при C=1 (меньше без знака); цель — config_invalid. */
    lds r20, test_t2 /* прочитать из SRAM тестовый T2 в r20. */
    lds r21, test_t2+1 /* прочитать из SRAM тестовый T2 в r21; смещение 1 выбирает следующий байт многобайтного значения. */
    cp r20, r18 /* сравнить операнды r20, r18; выставить флаги сравнения. */
    cpc r21, r19 /* сравнить операнды r21, r19; учесть входящий перенос для старшего байта. */
    BRLO_LONG config_invalid /* расширенный переход при C=1 (меньше без знака); цель — config_invalid. */

    rcall calc_gcd_binary /* вызвать подпрограмму calc_gcd_binary — рассчитать gcd(T1,T2) двоичным алгоритмом Штейна. */
    lds r20, gcd_result /* прочитать из SRAM результат НОД в r20. */
    lds r21, gcd_result+1 /* прочитать из SRAM результат НОД в r21; смещение 1 выбирает следующий байт многобайтного значения. */
    lds r18, required_g /* прочитать из SRAM минимально необходимый НОД в r18. */
    lds r19, required_g+1 /* прочитать из SRAM минимально необходимый НОД в r19; смещение 1 выбирает следующий байт многобайтного значения. */
    cp r20, r18 /* сравнить операнды r20, r18; выставить флаги сравнения. */
    cpc r21, r19 /* сравнить операнды r21, r19; учесть входящий перенос для старшего байта. */
    BRLO_LONG config_invalid /* расширенный переход при C=1 (меньше без знака); цель — config_invalid. */

    /* Проверить фазу: после первой строки и ответа должно остаться место для второй строки и защитного промежутка. */
    lds r20, tx1_cycles /* прочитать из SRAM длительность передачи строки 1 в r20. */
    lds r21, tx1_cycles+1 /* прочитать из SRAM длительность передачи строки 1 в r21; смещение 1 выбирает следующий байт многобайтного значения. */
    ldi r18, lo8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP) /* загрузить константу lo8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP) в r18; следующая инструкция использует это значение. */
    add r20, r18 /* сложить операнды (r20, r18); флаги нужны для проверки переполнения или следующего байта. */
    ldi r18, hi8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP) /* загрузить константу hi8(STATUS_TX_CYCLES + CONTROL_SLOT_SETUP) в r18; следующая инструкция использует это значение. */
    adc r21, r18 /* сложить операнды с переносом от младшего байта (r21, r18); флаги нужны для проверки переполнения или следующего байта. */
    lds r22, gcd_result /* прочитать из SRAM результат НОД в r22. */
    lds r23, gcd_result+1 /* прочитать из SRAM результат НОД в r23; смещение 1 выбирает следующий байт многобайтного значения. */
    cp r20, r22 /* сравнить операнды r20, r22; выставить флаги сравнения. */
    cpc r21, r23 /* сравнить операнды r21, r23; учесть входящий перенос для старшего байта. */
    BRSH_LONG config_invalid /* расширенный переход при C=0 (не меньше без знака); цель — config_invalid. */
    sub r22, r20 /* вычесть второй операнд из первого (r22, r20); флаги нужны для проверки переполнения или следующего байта. */
    sbc r23, r21 /* вычесть второй операнд вместе с переносом/заёмом (r23, r21); флаги нужны для проверки переполнения или следующего байта. */
    lds r18, tx2_cycles /* прочитать из SRAM длительность передачи строки 2 в r18. */
    lds r19, tx2_cycles+1 /* прочитать из SRAM длительность передачи строки 2 в r19; смещение 1 выбирает следующий байт многобайтного значения. */
    ldi r20, OUTPUT_GUARD_CYCLES /* загрузить константу OUTPUT_GUARD_CYCLES в r20; следующая инструкция использует это значение. */
    add r18, r20 /* сложить операнды (r18, r20); флаги нужны для проверки переполнения или следующего байта. */
    clr r20 /* обнулить регистр r20 перед его повторным использованием. */
    adc r19, r20 /* добавить к длительности второй строки защитный промежуток; сложить операнды с переносом от младшего байта (r19, r20); флаги нужны для проверки переполнения или следующего байта. */
    cp r22, r18 /* сравнить операнды r22, r18; выставить флаги сравнения. */
    cpc r23, r19 /* сравнить операнды r23, r19; учесть входящий перенос для старшего байта. */
    BRLO_LONG config_invalid /* расширенный переход при C=1 (меньше без знака); цель — config_invalid. */
    ldi r24, 1 /* загрузить константу 1 в r24; следующая инструкция использует это значение. */
    ret /* вернуться к инструкции после соответствующего RCALL. */
config_invalid:
    clr r24 /* обнулить регистр r24 перед его повторным использованием. */
    ret /* вернуться к инструкции после соответствующего RCALL. */

/* Вход: длина строки в r24; выход: длина×1360 тактов CPU в r21:r20. После умножения r1 обнуляется по соглашению AVR. */
calc_line_cycles:
    ldi r18, 80 /* 1360 = 80 + 5×256; так реализуется умножение длины на длительность кадра; загрузить константу 80 в r18; следующая инструкция использует это значение. */
    mul r24, r18 /* умножить r24, r18; 16-битный результат окажется в r1:r0. */
    mov r20, r0 /* скопировать значение r20, r0; исходный регистр не изменяется. */
    mov r21, r1 /* скопировать значение r21, r1; исходный регистр не изменяется. */
    ldi r18, 5 /* загрузить константу 5 в r18; следующая инструкция использует это значение. */
    mul r24, r18 /* умножить r24, r18; 16-битный результат окажется в r1:r0. */
    add r21, r0 /* сложить операнды (r21, r0); флаги нужны для проверки переполнения или следующего байта. */
    clr r1 /* обнулить регистр r1 перед его повторным использованием. */
    ret /* вернуться к инструкции после соответствующего RCALL. */

/* Двоичный алгоритм НОД: вход test_t1/test_t2, результат gcd_result. */
calc_gcd_binary:
    lds r20, test_t1 /* прочитать из SRAM тестовый T1 в r20. */
    lds r21, test_t1+1 /* r21:r20 содержит 16-разрядный операнд a; прочитать из SRAM тестовый T1 в r21; смещение 1 выбирает следующий байт многобайтного значения. */
    lds r22, test_t2 /* прочитать из SRAM тестовый T2 в r22. */
    lds r23, test_t2+1 /* r23:r22 содержит 16-разрядный операнд b; прочитать из SRAM тестовый T2 в r23; смещение 1 выбирает следующий байт многобайтного значения. */
    clr r19 /* Отделить общую степень двойки у операндов при вычислении НОД; обнулить регистр r19 перед его повторным использованием. */
gcd_loop:
    cp r20, r22 /* сравнить операнды r20, r22; выставить флаги сравнения. */
    cpc r21, r23 /* сравнить операнды r21, r23; учесть входящий перенос для старшего байта. */
    breq gcd_equal /* если Z=1 (результат равен нулю): перейти к gcd_equal. */
    sbrs r20, 0 /* пропустить следующую инструкцию, если бит 0 регистра r20 равен 1. */
    rjmp gcd_a_even /* безусловно передать управление на метку gcd_a_even; выполнение продолжится с указанной метки. */
    sbrs r22, 0 /* пропустить следующую инструкцию, если бит 0 регистра r22 равен 1. */
    rjmp gcd_b_even /* безусловно передать управление на метку gcd_b_even; выполнение продолжится с указанной метки. */
    /* оба числа нечётные */
    cp r20, r22 /* сравнить операнды r20, r22; выставить флаги сравнения. */
    cpc r21, r23 /* сравнить операнды r21, r23; учесть входящий перенос для старшего байта. */
    brlo gcd_b_minus_a /* если C=1 (меньше без знака): перейти к gcd_b_minus_a. */
    sub r20, r22 /* вычесть второй операнд из первого (r20, r22); флаги нужны для проверки переполнения или следующего байта. */
    sbc r21, r23 /* вычесть второй операнд вместе с переносом/заёмом (r21, r23); флаги нужны для проверки переполнения или следующего байта. */
    lsr r21 /* сдвинуть биты вправо с заполнением старшего бита нулём: r21; используется для арифметики/разбора числа. */
    ror r20 /* сдвинуть вправо через флаг переноса: r20; используется для арифметики/разбора числа. */
    rjmp gcd_loop /* безусловно передать управление на метку gcd_loop; выполнение продолжится с указанной метки. */
gcd_b_minus_a:
    sub r22, r20 /* вычесть второй операнд из первого (r22, r20); флаги нужны для проверки переполнения или следующего байта. */
    sbc r23, r21 /* вычесть второй операнд вместе с переносом/заёмом (r23, r21); флаги нужны для проверки переполнения или следующего байта. */
    lsr r23 /* сдвинуть биты вправо с заполнением старшего бита нулём: r23; используется для арифметики/разбора числа. */
    ror r22 /* сдвинуть вправо через флаг переноса: r22; используется для арифметики/разбора числа. */
    rjmp gcd_loop /* безусловно передать управление на метку gcd_loop; выполнение продолжится с указанной метки. */
gcd_a_even:
    sbrs r22, 0 /* пропустить следующую инструкцию, если бит 0 регистра r22 равен 1. */
    rjmp gcd_both_even /* безусловно передать управление на метку gcd_both_even; выполнение продолжится с указанной метки. */
    lsr r21 /* сдвинуть биты вправо с заполнением старшего бита нулём: r21; используется для арифметики/разбора числа. */
    ror r20 /* сдвинуть вправо через флаг переноса: r20; используется для арифметики/разбора числа. */
    rjmp gcd_loop /* безусловно передать управление на метку gcd_loop; выполнение продолжится с указанной метки. */
gcd_b_even:
    lsr r23 /* сдвинуть биты вправо с заполнением старшего бита нулём: r23; используется для арифметики/разбора числа. */
    ror r22 /* сдвинуть вправо через флаг переноса: r22; используется для арифметики/разбора числа. */
    rjmp gcd_loop /* безусловно передать управление на метку gcd_loop; выполнение продолжится с указанной метки. */
gcd_both_even:
    lsr r21 /* сдвинуть биты вправо с заполнением старшего бита нулём: r21; используется для арифметики/разбора числа. */
    ror r20 /* сдвинуть вправо через флаг переноса: r20; используется для арифметики/разбора числа. */
    lsr r23 /* сдвинуть биты вправо с заполнением старшего бита нулём: r23; используется для арифметики/разбора числа. */
    ror r22 /* сдвинуть вправо через флаг переноса: r22; используется для арифметики/разбора числа. */
    inc r19 /* увеличить на 1 (r19); флаги результата используются далее. */
    rjmp gcd_loop /* безусловно передать управление на метку gcd_loop; выполнение продолжится с указанной метки. */
gcd_equal:
    tst r19 /* проверить r19 без изменения самого регистра; результат задаёт флаги Z/N. */
    breq gcd_store /* если Z=1 (результат равен нулю): перейти к gcd_store. */
    lsl r20 /* сдвинуть биты влево, младший бит становится нулём: r20; используется для арифметики/разбора числа. */
    rol r21 /* сдвинуть влево через флаг переноса: r21; используется для арифметики/разбора числа. */
    dec r19 /* уменьшить на 1 (r19); флаги результата используются далее. */
    rjmp gcd_equal /* безусловно передать управление на метку gcd_equal; выполнение продолжится с указанной метки. */
gcd_store:
    sts gcd_result, r20 /* сохранить gcd_result в SRAM (r20). */
    sts gcd_result+1, r21 /* сохранить gcd_result+1 в SRAM (r21). */
    ret /* вернуться к инструкции после соответствующего RCALL. */
