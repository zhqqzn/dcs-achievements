/*
 * Функциональный модуль: timer2.inc
 * Назначение: независимый аппаратный Timer2 формирует периодический поток pong.
 * Timer2 работает в CTC с делителем 128; поэтому его период должен быть кратен
 * 128 тактам CPU и находиться в диапазоне 128..32768 тактов. Эти ограничения
 * проверяются до фиксации конфигурации; неподдерживаемые команды получают ERR.
 * Регистр r2 зарезервирован за первым байтом pong: основной код его не изменяет.
 */

/* Остановить Timer2, загрузить период CTC и кешировать первый байт активной строки. */
timer2_configure:
    ldi r16, (1<<WGM21)             /* Оставить CTC, но выбрать нулевой источник тактов для остановки. */
    out _SFR_IO_ADDR(TCCR2), r16    /* Остановить Timer2 перед изменением его счётчика и OCR2. */
    clr r16                         /* Подготовить нулевое значение. */
    out _SFR_IO_ADDR(TCNT2), r16    /* Обнулить восьмиразрядный счётчик Timer2. */
    lds r18, active_t2+1            /* Загрузить старший байт периода T2. */
    lsl r18                         /* Удвоить старший байт: T2/128 = 2*high + bit7(low). */
    lds r19, active_t2              /* Загрузить младший байт периода T2. */
    sbrc r19, 7                     /* Если младший байт кратного 128 периода равен 128, */
    inc r18                         /* добавить единицу к количеству тиков Timer2. */
    dec r18                         /* OCR2=количество тиков−1; переполнение корректно даёт 255 для 32768. */
    out _SFR_IO_ADDR(OCR2), r18     /* Задать TOP; CTC будет выдавать одно сравнение через каждый период T2. */
    ldi r16, (1<<OCF2)              /* Подготовить очистку возможного старого Compare2-флага. */
    out _SFR_IO_ADDR(TIFR), r16     /* Очистить OCF2, чтобы не запустить старое событие после включения. */
    ldi r30, lo8(active_str2)       /* Начать чтение активной строки pong с её первого байта. */
    ldi r31, hi8(active_str2)       /* Загрузить старшую часть адреса active_str2. */
    ld r2, Z                        /* Кешировать первый байт строки в зарезервированном регистре r2. */
    ret                             /* Вернуться, оставив Timer2 остановленным до фазового события Timer1B. */

/* Вектор Timer2 Compare Match ATmega8 — __vector_3. */
.global __vector_3
__vector_3:
    out _SFR_IO_ADDR(UDR), r2       /* Записать первый байт pong сразу после входа в вектор; путь фиксирован. */
#if TRACE_SCHEDULE
    out _SFR_IO_ADDR(PORTB), r2     /* В сборке трассировки пометить исходящий байт, не затрагивая штатный режим. */
#endif
    push r0                         /* Сохранить r0 после критической записи первого байта. */
    in r0, _SFR_IO_ADDR(SREG)       /* Сохранить флаги до последующих арифметических инструкций. */
    push r0                         /* Сохранить исходный SREG на стеке. */
    push r24                        /* Сохранить регистр, используемый при настройке указателя передачи. */
    push r30                        /* Сохранить младший байт указателя Z прерванного кода. */
    push r31                        /* Сохранить старший байт указателя Z прерванного кода. */
    ldi r24, (1<<TXC)|(1<<U2X)       /* Очистить TXC записью единицы и сохранить удвоенный режим скорости. */
    out _SFR_IO_ADDR(UCSRA), r24    /* Зафиксировать очистку TXC после загрузки первого байта в UDR. */
    ldi r30, lo8(active_str2+1)     /* Остальные байты строки передаст главный цикл, начиная со второго. */
    ldi r31, hi8(active_str2+1)     /* Загрузить старшую часть указателя на остаток строки pong. */
    sts tx_ptr_lo, r30              /* Сохранить младший байт указателя передачи. */
    sts tx_ptr_hi, r31              /* Сохранить старший байт указателя передачи. */
    ldi r24, 2                      /* Код 2 обозначает активную передачу строки TIMER2_STR. */
    sts tx_kind, r24                /* Запустить программную передачу остатка строки pong. */
    clr r24                         /* Подготовить закрытое состояние окна ответа команды. */
    sts control_slot_open, r24      /* Ответы OK/ERR не должны начинаться поверх строки pong. */
    pop r31                         /* Восстановить старший байт Z прерванного кода. */
    pop r30                         /* Восстановить младший байт Z прерванного кода. */
    pop r24                         /* Восстановить r24 прерванного кода. */
    pop r0                          /* Восстановить сохранённый SREG во временный r0. */
    out _SFR_IO_ADDR(SREG), r0      /* Восстановить флаги до прерывания. */
    pop r0                          /* Восстановить исходное значение r0. */
    reti                            /* Завершить Compare2; CTC сам подготовит следующее событие через T2. */
