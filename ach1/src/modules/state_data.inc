/*
 * Функциональный модуль: state_data.inc
 * Назначение: Инициализируемые данные: активные и кандидатные интервалы, строки и фиксированные ответы USART.
 * Фрагмент включается в одну единицу трансляции firmware.S: общие метки SRAM
 * остаются видимыми без отдельной таблицы экспортируемых символов, а порядок
 * критичных инструкций и временные характеристики не меняются компоновкой.
 */
/* ------------------------------- SRAM data ------------------------------- */
.section .data
active_t1:              .word TIMER1_INTERVAL /* Действующий период первого потока, 16 бит; хранится младшим байтом первым. */
active_t2:              .word TIMER2_INTERVAL /* Действующий период второго потока, 16 бит; хранится младшим байтом первым. */
candidate_t1:           .word TIMER1_INTERVAL /* Проверенный кандидат периода T1; применяется только после допуска расписания. */
candidate_t2:           .word TIMER2_INTERVAL /* Проверенный кандидат периода T2; применяется только после допуска расписания. */

active_str1_len:        .byte 6 /* Количество передаваемых байтов первой строки, включая CR и LF, но без NUL. */
active_str1:            .ascii "ping\r\n" /* Первая активная строка для периодической передачи: ping + CR/LF. */
                        .byte 0 /* NUL завершает строку в SRAM; этот байт не передаётся в USART. */
                        .space (MAX_STR_LEN + 1 - 7) /* Зарезервировать остаток буфера, чтобы следующий объект имел фиксированный адрес. */
active_str2_len:        .byte 6 /* Количество передаваемых байтов второй строки, включая CR и LF, но без NUL. */
active_str2:            .ascii "pong\r\n" /* Вторая активная строка для периодической передачи: pong + CR/LF. */
                        .byte 0 /* NUL завершает строку в SRAM; этот байт не передаётся в USART. */
                        .space (MAX_STR_LEN + 1 - 7) /* Зарезервировать остаток буфера, чтобы следующий объект имел фиксированный адрес. */

candidate_str1_len:     .byte 6 /* Длина кандидатной первой строки, проверяется до применения. */
candidate_str1:         .ascii "ping\r\n" /* Буфер первой строки-кандидата; не меняет активный вывод до фиксации. */
                        .byte 0 /* NUL завершает строку в SRAM; этот байт не передаётся в USART. */
                        .space (MAX_STR_LEN + 1 - 7) /* Зарезервировать остаток буфера, чтобы следующий объект имел фиксированный адрес. */
candidate_str2_len:     .byte 6 /* Длина кандидатной второй строки, проверяется до применения. */
candidate_str2:         .ascii "pong\r\n" /* Буфер второй строки-кандидата; не меняет активный вывод до фиксации. */
                        .byte 0 /* NUL завершает строку в SRAM; этот байт не передаётся в USART. */
                        .space (MAX_STR_LEN + 1 - 7) /* Зарезервировать остаток буфера, чтобы следующий объект имел фиксированный адрес. */

temp_string_len:        .byte 0 /* Временная длина строки при разборе команды S1/S2. */
temp_string:            .space (MAX_STR_LEN + 1) /* Временный буфер; позволяет проверить новую строку до изменения кандидата. */

msg_ok:                 .asciz "OK\r\n" /* Неизменяемый ответ на принятую команду. */
msg_error:              .asciz "ERR\r\n" /* Неизменяемый ответ на отклонённую команду. */
cmd_restart:            .asciz "RESTART" /* Шаблон команды перезапуска расписания. */
