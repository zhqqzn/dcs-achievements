# Local demo database. DB_HOST can be changed for an external PostgreSQL host.
DB_HOST=database
DB_PORT=5432
DB_NAME=linear
DB_USER=linear
# Demo-only password. Change this before exposing the service outside localhost.
DB_PASSWORD=coursework_demo_password
# Allows every non-negative BIGINT input for which input + 1 fits BIGINT.
MAX_INPUT=9223372036854775806
